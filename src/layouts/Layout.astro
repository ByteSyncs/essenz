---
import ModernLayout from './ModernLayout.astro'
import MinimalistLayout from './MinimalistLayout.astro'

interface Props {
  title: string
  description: string
  theme?: 'modern' | 'minimalist'
  preloadImage?: string
}

const { title, description, theme = 'modern', preloadImage } = Astro.props
---

{
  theme === 'minimalist' ? (
    <MinimalistLayout title={title} description={description} preloadImage={preloadImage}>
      <slot />
    </MinimalistLayout>
  ) : (
    <ModernLayout title={title} description={description} preloadImage={preloadImage}>
      <slot />
    </ModernLayout>
  )
}
