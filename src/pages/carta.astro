---
import Layout from '../layouts/Layout.astro'
import Header from '../components/Header.astro'
import { CARTA_MENU } from '../data/menu'

const categories = CARTA_MENU
---

<Layout
  title="Menú | ByteSyncs Café"
  description="Fichas técnicas de nuestra selección de especialidad."
>
  <Header />

  <main class="pt-32 pb-20 bg-[#F5EFE6] relative">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="relative py-16 mb-10 text-center border-y border-[#2C1E16]/10">
        <h1
          class="text-6xl md:text-8xl font-bold text-[#2C1E16] uppercase tracking-tighter opacity-5 absolute inset-0 flex items-center justify-center select-none"
        >
          MENU
        </h1>
        <div class="relative z-10">
          <span class="text-[#2E4F3F] font-bold tracking-[0.3em] uppercase text-xs mb-3 block">
            ByteSyncs Experience
          </span>
          <h2 class="text-4xl md:text-5xl font-bold text-[#2C1E16] italic">Selección de Autor</h2>
        </div>
      </div>

      <div class="mb-12 max-w-md mx-auto">
        <div class="relative">
          <svg
            class="absolute left-4 top-1/2 -translate-y-1/2 text-[#2C1E16]/30 pointer-events-none"
            width="16"
            height="16"
            viewBox="0 0 16 16"
            fill="none"
          >
            <circle cx="6.5" cy="6.5" r="5" stroke="currentColor" stroke-width="1.5"></circle>
            <path
              d="M10.5 10.5L14 14"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="round"></path>
          </svg>
          <input
            id="search-input"
            type="text"
            placeholder="Buscá por nombre, nota o categoría…"
            class="w-full bg-white border border-[#2C1E16]/10 pl-10 pr-4 py-3 text-sm text-[#2C1E16] placeholder:text-[#2C1E16]/30 outline-none focus:border-[#2E4F3F] transition-colors"
            style="border-radius: 2px;"
          />
          <button
            id="clear-search"
            class="absolute right-3 top-1/2 -translate-y-1/2 text-[#2C1E16]/30 hover:text-[#2C1E16] transition-colors hidden"
            aria-label="Limpiar búsqueda"
          >
            <svg width="14" height="14" viewBox="0 0 14 14" fill="none">
              <path
                d="M1 1L13 13M13 1L1 13"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linecap="round"></path>
            </svg>
          </button>
        </div>
        <p id="search-empty" class="hidden text-center text-sm text-[#2C1E16]/40 mt-6">
          No encontramos nada para <span id="search-term" class="font-semibold text-[#2C1E16]/60"
          ></span>.
        </p>
      </div>

      <div class="space-y-24" id="menu-container">
        {
          categories.map((cat) => (
            <section id={cat.id} data-section>
              <div class="flex items-center gap-4 mb-10">
                <h3 class="text-2xl font-bold text-[#2C1E16] whitespace-nowrap">{cat.title}</h3>
                <div class="h-px bg-[#2C1E16]/10 w-full" />
              </div>

              <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
                {cat.items.map((item) => (
                  <div
                    class="menu-item bg-white border border-[#2C1E16]/5 p-6 hover:shadow-xl hover:shadow-[#2C1E16]/5 transition-all cursor-pointer group"
                    data-nombre={item.name.toLowerCase()}
                    data-notas={(item.details?.notes ?? []).join(' ').toLowerCase()}
                    data-categoria={cat.title.toLowerCase()}
                    data-details={JSON.stringify(item)}
                  >
                    <div class="flex justify-between items-start mb-4">
                      <h4 class="text-xl font-bold text-[#2C1E16] group-hover:text-[#8B5A2B] transition-colors">
                        {item.name}
                      </h4>
                      {item.intensity && (
                        <div class="flex gap-1 items-end">
                          {[...Array(5)].map((_, i) => (
                            <div
                              class={`w-1 h-3 ${i < item.intensity! ? 'bg-[#8B5A2B]' : 'bg-gray-200'}`}
                            />
                          ))}
                        </div>
                      )}
                    </div>

                    <p class="text-gray-500 text-sm leading-relaxed mb-6">{item.description}</p>

                    <div class="pt-4 border-t border-gray-50 flex justify-between items-center">
                      <span class="text-[#8B5A2B] font-bold text-lg">{item.price}</span>
                      <span class="text-[10px] font-bold uppercase tracking-widest text-[#2E4F3F] opacity-0 group-hover:opacity-100 transition-opacity">
                        Ver ficha técnica →
                      </span>
                    </div>
                  </div>
                ))}
              </div>
            </section>
          ))
        }
      </div>

      <div id="search-results" class="hidden">
        <div class="flex items-center gap-4 mb-10">
          <h3 class="text-2xl font-bold text-[#2C1E16] whitespace-nowrap">Resultados</h3>
          <div class="h-px bg-[#2C1E16]/10 w-full"></div>
        </div>
        <div id="search-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6"></div>
      </div>
    </div>
  </main>

  <dialog
    id="item-modal"
    class="backdrop:bg-[#2C1E16]/80 p-0 rounded-none border-none bg-transparent max-w-lg w-full absolute top-1/2 left-1/2 -translate-y-1/2 -translate-x-1/2"
  >
    <div class="bg-[#F5EFE6] p-8 relative shadow-2xl border border-[#2C1E16]/10">
      <button
        id="close-modal"
        class="absolute top-4 right-4 text-[#2C1E16] hover:rotate-90 transition-transform"
        aria-label="Cerrar"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="24"
          height="24"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>

      <div id="modal-content"></div>

      <div class="mt-8">
        <button
          class="bg-[#2C1E16] text-white px-8 py-3 text-xs font-bold uppercase tracking-widest hover:bg-[#2E4F3F] transition-colors w-full"
        >
          Ordenar este producto
        </button>
      </div>
    </div>
  </dialog>
</Layout>

<script>
  const modal = document.querySelector('#item-modal') as HTMLDialogElement
  const closeModalBtn = document.querySelector('#close-modal')
  const modalContent = document.querySelector('#modal-content')

  function buildModalHTML(data: any) {
    const notes = (data.details?.notes ?? [])
      .map(
        (note: string) =>
          `<span class="bg-[#2C1E16]/5 px-2 py-1 text-[#2C1E16] text-xs">#${note}</span>`,
      )
      .join('')

    return `
      <span class="text-[#2E4F3F] font-bold tracking-widest uppercase text-[10px] mb-2 block">Ficha Técnica</span>
      <h3 class="text-3xl font-bold text-[#2C1E16] mb-6 lowercase italic">${data.name}</h3>
      <div class="grid grid-cols-2 gap-6 text-sm border-t border-[#2C1E16]/10 pt-6">
        <div>
          <p class="text-gray-400 uppercase text-[10px] font-bold mb-1">Cuerpo / Gramaje</p>
          <p class="text-[#2C1E16] font-medium">${data.details?.grams ?? 'Estándar'}</p>
        </div>
        <div>
          <p class="text-gray-400 uppercase text-[10px] font-bold mb-1">Nivel de Amargor</p>
          <p class="text-[#2C1E16] font-medium">${data.details?.bitterness ?? 'N/A'}</p>
        </div>
        <div class="col-span-2">
          <p class="text-gray-400 uppercase text-[10px] font-bold mb-1">Perfil de Sabor</p>
          <div class="flex gap-2 mt-1 flex-wrap">${notes}</div>
        </div>
        <div>
          <p class="text-gray-400 uppercase text-[10px] font-bold mb-1">Azúcares</p>
          <p class="text-[#2C1E16] font-medium">${data.details?.sugar ?? '0g'}</p>
        </div>
        <div>
          <p class="text-gray-400 uppercase text-[10px] font-bold mb-1">Precio Final</p>
          <p class="text-[#8B5A2B] font-bold text-lg">${data.price}</p>
        </div>
      </div>
    `
  }

  function openModal(data: any) {
    if (modalContent) modalContent.innerHTML = buildModalHTML(data)
    modal.showModal()
  }

  closeModalBtn?.addEventListener('click', () => modal.close())
  modal.addEventListener('click', (e) => {
    const r = modal.getBoundingClientRect()
    const ev = e as MouseEvent
    if (
      ev.clientX < r.left ||
      ev.clientX > r.right ||
      ev.clientY < r.top ||
      ev.clientY > r.bottom
    ) {
      modal.close()
    }
  })

  function attachModalToItems(items: NodeListOf<Element> | Element[]) {
    items.forEach((item) => {
      item.addEventListener('click', () => {
        const data = JSON.parse((item as HTMLElement).getAttribute('data-details') || '{}')
        openModal(data)
      })
    })
  }

  attachModalToItems(document.querySelectorAll('.menu-item'))

  const searchInput = document.getElementById('search-input') as HTMLInputElement
  const clearBtn = document.getElementById('clear-search')!
  const searchEmpty = document.getElementById('search-empty')!
  const searchTerm = document.getElementById('search-term')!
  const menuContainer = document.getElementById('menu-container')!
  const searchResults = document.getElementById('search-results')!
  const searchGrid = document.getElementById('search-grid')!

  const allItems: HTMLElement[] = Array.from(document.querySelectorAll('.menu-item')).map(
    (el) => el.cloneNode(true) as HTMLElement,
  )

  function buildCard(item: HTMLElement): HTMLElement {
    const clone = item.cloneNode(true) as HTMLElement
    clone.addEventListener('click', () => {
      const data = JSON.parse(clone.getAttribute('data-details') || '{}')
      openModal(data)
    })
    return clone
  }

  function runSearch(query: string) {
    const q = query.trim().toLowerCase()

    clearBtn.classList.toggle('hidden', q === '')

    if (q === '') {
      menuContainer.classList.remove('hidden')
      searchResults.classList.add('hidden')
      searchEmpty.classList.add('hidden')
      return
    }

    menuContainer.classList.add('hidden')
    searchResults.classList.remove('hidden')

    const matches = allItems.filter((item) => {
      const nombre = item.dataset.nombre ?? ''
      const notas = item.dataset.notas ?? ''
      const categoria = item.dataset.categoria ?? ''
      return nombre.includes(q) || notas.includes(q) || categoria.includes(q)
    })

    searchGrid.innerHTML = ''
    searchTerm.textContent = `"${query.trim()}"`

    if (matches.length === 0) {
      searchEmpty.classList.remove('hidden')
    } else {
      searchEmpty.classList.add('hidden')
      matches.forEach((item) => searchGrid.appendChild(buildCard(item)))
    }
  }

  let debounceTimer: ReturnType<typeof setTimeout>
  searchInput.addEventListener('input', () => {
    clearTimeout(debounceTimer)
    debounceTimer = setTimeout(() => runSearch(searchInput.value), 200)
  })

  clearBtn.addEventListener('click', () => {
    searchInput.value = ''
    runSearch('')
    searchInput.focus()
  })
</script>

<style>
  main {
    background-image: radial-gradient(#2c1e1611 1px, transparent 1px);
    background-size: 40px 40px;
  }
  dialog::backdrop {
    background: rgba(44, 30, 22, 0.8);
    backdrop-filter: blur(4px);
  }
  dialog[open] {
    animation: slideUp 0.25s ease-out;
  }
  @keyframes slideUp {
    from {
      opacity: 0;
      transform: translateY(16px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>
