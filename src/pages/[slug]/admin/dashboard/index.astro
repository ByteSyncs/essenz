---
import MinimalistLayout from '../../../../layouts/MinimalistLayout.astro'
import DashboardShell from '../../../../components/react/dashboard/DashboardShell.tsx'
import { isOwnerRole } from '../../../../libs/permissions'

const { slug } = Astro.params
const { supabase, user } = Astro.locals

if (!user) {
  return Astro.redirect('/auth/sign-in')
}

const { data: profile } = await supabase
  .from('profiles')
  .select(
    `
    is_setup_complete,
    role,
    account_id,
    organizations (slug, account_id)
  `,
  )
  .eq('id', user.id)
  .single()

const org = Array.isArray(profile?.organizations)
  ? profile.organizations[0]
  : profile?.organizations

if (!org) {
  return Astro.redirect('/?error=unauthorized')
}

const isOwner = isOwnerRole(profile?.role)

if (org.slug !== slug) {
  const accountId = profile?.account_id ?? org.account_id ?? null
  let isAccountBranch = false

  if (isOwner && accountId) {
    const { data: branch } = await supabase
      .from('organizations')
      .select('id')
      .eq('slug', slug)
      .eq('account_id', accountId)
      .maybeSingle()
    isAccountBranch = Boolean(branch)
  }

  if (!isAccountBranch) {
    return Astro.redirect('/?error=unauthorized')
  }
}

if (!profile?.is_setup_complete) {
  return Astro.redirect(`/${slug}/admin/setup`)
}
---

<MinimalistLayout
  title="Dashboard | Essenz"
  description="Panel de administración de tu carta digital."
>
  <DashboardShell
    slug={slug!}
    role={profile?.role ?? 'employee'}
    showAccountLink={isOwner}
    client:load
  />
</MinimalistLayout>
