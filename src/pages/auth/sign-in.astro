---
import AuthLayout from '../../layouts/AuthLayout.astro'
import LoginForm from '../../components/auth/SingInForm'
import logo from '../../assets/essenz.webp'

const { locals, redirect, cookies, response, url } = Astro

response.headers.set('Cache-Control', 'no-store')
response.headers.set('X-Frame-Options', 'DENY')
response.headers.set('Content-Security-Policy', "frame-ancestors 'none'")
response.headers.set('Referrer-Policy', 'no-referrer')

const SLUG_PATTERN = /^[a-z0-9]+(?:-[a-z0-9]+)*$/i

const notices = {
  'session-expired': 'Tu sesión venció. Ingresá de nuevo para continuar.',
  'signed-out': 'Cerraste sesión correctamente.',
  'account-created': 'Tu cuenta está lista. Ingresá para empezar.',
  'password-updated': 'Actualizamos tu contraseña. Ingresá con la nueva.',
} as const

const noticeKey = url.searchParams.get('notice')
const notice =
  noticeKey && Object.hasOwn(notices, noticeKey) ? notices[noticeKey as keyof typeof notices] : null

const accessToken = cookies.get('sb-access-token')?.value
const refreshToken = cookies.get('sb-refresh-token')?.value

if (accessToken && refreshToken) {
  try {
    const { data, error } = await locals.supabase.auth.setSession({
      access_token: accessToken,
      refresh_token: refreshToken,
    })

    const userId = data?.session?.user.id

    if (!error && userId) {
      const { data: profile } = await locals.supabase
        .from('profiles')
        .select('organizations (slug)')
        .eq('id', userId)
        .maybeSingle()

      const org = Array.isArray(profile?.organizations)
        ? profile.organizations[0]
        : profile?.organizations

      if (org?.slug && SLUG_PATTERN.test(org.slug)) {
        return redirect(`/${encodeURIComponent(org.slug)}/admin/dashboard`)
      }
    }
  } catch (err) {
    console.error('[sign-in] auto-login failed:', err instanceof Error ? err.message : 'unknown')
  }
}

const year = new Date().getFullYear()
const capabilities = [
  { label: 'Carta digital', detail: 'Productos, categorías y ofertas siempre al día.' },
  { label: 'Pedidos y cobros', detail: 'Comandas con su estado en un mismo lugar.' },
  { label: 'Inventario y gastos', detail: 'Insumos, movimientos y números del negocio.' },
]
---

<AuthLayout
  title="Iniciar sesión — Essenz"
  description="Ingresá a tu panel de Essenz para gestionar la carta, los pedidos y el inventario de tu local."
>
  <main class="min-h-svh bg-[#faf8f4] text-(--clr-ink)">
    <div class="mx-auto flex min-h-svh max-w-6xl flex-col px-5 sm:px-8">
      <header class="rise flex items-center justify-between py-5 sm:py-6" style="--i:0">
        <a
          href="/"
          aria-label="Volver al inicio de Essenz"
          class="press -ml-1 flex min-h-11 items-center gap-2.5 px-1 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-(--clr-accent)"
        >
          <img
            src={logo.src}
            alt=""
            width={160}
            height={80}
            loading="eager"
            decoding="async"
            draggable={false}
            class="h-11 w-auto object-contain sm:h-14"
          />
        </a>
        <a
          href="/"
          class="press inline-flex min-h-11 items-center px-2 text-sm font-medium text-stone-600 hover:text-(--clr-ink) focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-(--clr-accent)"
        >
          <span aria-hidden="true" class="mr-2">←</span>Volver al sitio
        </a>
      </header>

      <div
        class="grid flex-1 items-center gap-12 pb-12 lg:grid-cols-[1fr_minmax(0,24rem)] lg:gap-28"
      >
        <aside class="hidden lg:block" aria-label="Qué incluye Essenz">
          <p
            class="rise text-xs font-bold uppercase tracking-[0.22em] text-(--clr-accent)"
            style="--i:1"
          >
            Para cafeterías, restaurantes, bares y panaderías
          </p>
          <p
            class="rise mt-5 max-w-lg text-balance text-5xl leading-[1.04] font-semibold tracking-[-0.035em] xl:text-6xl"
            style="--i:2"
          >
            Todo tu local, en un solo lugar.
          </p>
          <ul class="mt-12 max-w-md divide-y divide-stone-200 border-y border-stone-200">
            {
              capabilities.map((item, index) => (
                <li class="rise py-4" style={`--i:${index + 3}`}>
                  <p class="text-sm font-semibold">{item.label}</p>
                  <p class="mt-1 text-sm leading-relaxed text-stone-600">{item.detail}</p>
                </li>
              ))
            }
          </ul>
        </aside>

        <section
          class="mx-auto w-full max-w-sm lg:mx-0 lg:justify-self-end"
          aria-labelledby="sign-in-heading"
        >
          <h1
            id="sign-in-heading"
            class="rise text-3xl font-semibold tracking-[-0.03em] sm:text-4xl"
            style="--i:1"
          >
            Iniciar sesión
          </h1>
          <p class="rise mt-2 text-sm leading-relaxed text-stone-600" style="--i:2">
            Ingresá a tu panel de Essenz.
          </p>

          {
            notice && (
              <p
                role="status"
                class="rise mt-6 border-l-2 border-(--clr-ink) bg-white px-4 py-3 text-sm leading-relaxed"
                style="--i:2"
              >
                {notice}
              </p>
            )
          }

          <div class="auth-form rise mt-8" style="--i:3">
            <LoginForm client:load />
          </div>

          <p
            class="rise mt-8 border-t border-stone-200 pt-6 text-sm leading-relaxed text-stone-600"
            style="--i:4"
          >
            ¿Todavía no tenés cuenta?
            <a
              href="/plans"
              class="press ml-1 inline-flex min-h-11 items-center font-semibold text-(--clr-ink) underline underline-offset-4 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-(--clr-accent)"
            >
              Crear cuenta
            </a>
          </p>
        </section>
      </div>

      <footer
        class="flex flex-col gap-1 border-t border-stone-200 py-6 text-xs text-stone-500 sm:flex-row sm:justify-between"
        style="padding-bottom: max(1.5rem, env(safe-area-inset-bottom, 0px))"
      >
        <span>© {year} Essenz</span>
        <span>Un producto de ByteSyncs</span>
      </footer>
    </div>
  </main>

  <style>
    :global(html) {
      -webkit-tap-highlight-color: transparent;
      -webkit-text-size-adjust: 100%;
    }

    a,
    button {
      touch-action: manipulation;
    }

    .auth-form :global(input),
    .auth-form :global(select),
    .auth-form :global(textarea) {
      font-size: 16px;
    }

    .press {
      transition:
        transform 160ms cubic-bezier(0.23, 1, 0.32, 1),
        color 160ms ease;
    }

    .press:active {
      transform: scale(0.97);
    }

    @media (prefers-reduced-motion: no-preference) {
      .rise {
        opacity: 1;
        transform: translateY(0);
        transition:
          opacity 420ms cubic-bezier(0.23, 1, 0.32, 1),
          transform 420ms cubic-bezier(0.23, 1, 0.32, 1);
        transition-delay: calc(var(--i, 0) * 60ms);
      }

      @starting-style {
        .rise {
          opacity: 0;
          transform: translateY(10px);
        }
      }
    }
  </style>
</AuthLayout>
