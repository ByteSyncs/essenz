---
import AuthLayout from '../../layouts/AuthLayout.astro'
import LoginForm from '../../components/auth/SingInForm'

const { locals, redirect, cookies } = Astro

const accessToken = cookies.get('sb-access-token')?.value
const refreshToken = cookies.get('sb-refresh-token')?.value

if (accessToken && refreshToken) {
  try {
    const { data, error } = await locals.supabase.auth.setSession({
      access_token: accessToken,
      refresh_token: refreshToken,
    })

    if (data && !error) {
      const { data: profile } = await locals.supabase
        .from('profiles')
        .select('organizations (slug)')
        .eq('id', data.session?.user.id)
        .maybeSingle()

      const org = Array.isArray(profile?.organizations)
        ? profile.organizations[0]
        : profile?.organizations

      if (org?.slug) {
        return redirect(`/${org.slug}/admin/dashboard`)
      }
    }
  } catch (err) {
    console.error('Error auto-login bypass:', err)
  }
}
---

<AuthLayout
  title="Acceso Administrador — ByteSyncs"
  description="Panel de administración exclusivo para establecimientos de cafetería con ByteSyncs."
>
  <main class="min-h-screen grid grid-cols-1 lg:grid-cols-2">
    <aside
      class="hidden lg:flex flex-col justify-between p-12 xl:p-16 relative overflow-hidden"
      style="background-color: var(--clr-ink-dark);"
    >
      <div class="absolute inset-0 opacity-10 pointer-events-none select-none">
        <svg width="100%" height="100%" xmlns="http://www.w3.org/2000/svg">
          <defs>
            <pattern id="grain" x="0" y="0" width="80" height="80" patternUnits="userSpaceOnUse">
              <circle cx="40" cy="20" r="1.2" fill="#b08d57" opacity="0.6"></circle>
              <circle cx="20" cy="60" r="0.8" fill="#b08d57" opacity="0.4"></circle>
              <circle cx="65" cy="55" r="1" fill="#b08d57" opacity="0.5"></circle>
              <circle cx="10" cy="10" r="0.6" fill="#b08d57" opacity="0.3"></circle>
              <circle cx="75" cy="5" r="1" fill="#b08d57" opacity="0.4"></circle>
            </pattern>
          </defs>
          <rect width="100%" height="100%" fill="url(#grain)"></rect>
        </svg>
      </div>

      <div
        class="absolute top-0 right-0 w-64 h-64 rounded-full opacity-5 -translate-y-1/2 translate-x-1/2"
        style="background: var(--clr-accent-light);"
      >
      </div>
      <div
        class="absolute bottom-0 left-0 w-96 h-96 rounded-full opacity-5 translate-y-1/3 -translate-x-1/3"
        style="background: var(--clr-accent);"
      >
      </div>

      <div class="relative z-10">
        <div class="flex items-center gap-3 mb-2">
          <div
            class="w-8 h-8 rounded-sm flex items-center justify-center"
            style="background: var(--clr-accent);"
          >
            <svg
              width="16"
              height="16"
              viewBox="0 0 16 16"
              fill="none"
              xmlns="http://www.w3.org/2000/svg"
            >
              <rect x="2" y="2" width="5" height="5" rx="1" fill="#f5efe6"></rect>
              <rect x="9" y="2" width="5" height="5" rx="1" fill="#f5efe6" opacity="0.6"></rect>
              <rect x="2" y="9" width="5" height="5" rx="1" fill="#f5efe6" opacity="0.6"></rect>
              <rect x="9" y="9" width="5" height="5" rx="1" fill="#f5efe6"></rect>
            </svg>
          </div>
          <span class="text-sm tracking-widest uppercase text-(--clr-white)">
            Byte<span class="text-[#648f57]">Syncs</span>
          </span>
        </div>
      </div>

      <div class="relative z-10 space-y-8">
        <div>
          <p
            class="text-xs tracking-widest uppercase mb-4"
            style="color: var(--clr-accent-light); font-family: 'DM Sans', sans-serif;"
          >
            Visión a largo plazo
          </p>
          <h1
            class="text-5xl xl:text-6xl leading-tight"
            style="color: var(--clr-bg); font-family: 'Cormorant Garamond', serif; font-weight: 300;"
          >
            Capitalizá tu visión,<br />
            <em style="font-style: italic; color: var(--clr-accent-light);">asegurá el mañana.</em>
          </h1>
        </div>

        <p
          class="text-base leading-relaxed max-w-sm"
          style="color: rgba(245,239,230,0.65); font-family: 'DM Sans', sans-serif; font-weight: 300;"
        >
          Un sistema no es un gasto, es el cimiento de un negocio ordenado. Comenzá hoy tomando el
          control total de tu menú y prepará tu cafetería para el crecimiento.
        </p>

        <div class="space-y-4 pt-2">
          {
            [
              { icon: '◈', label: 'Gestión de menú ágil y centralizada', active: true },
              { icon: '◈', label: 'Actualización de precios en tiempo real', active: true },
              { icon: '◈', label: 'Control de stock e inventario detallado', active: false },
              { icon: '◈', label: 'Reportes avanzados y métricas', active: false },
            ].map((item) => (
              <div class={`flex items-center gap-3 ${!item.active ? 'opacity-60' : ''}`}>
                <span class="text-xs" style="color: var(--clr-accent);">
                  {item.icon}
                </span>
                <span
                  class="text-sm flex items-center gap-2"
                  style="color: rgba(245,239,230,0.8); font-family: 'DM Sans', sans-serif;"
                >
                  {item.label}
                  {!item.active && (
                    <span
                      class="text-[10px] px-1.5 py-0.5 rounded-sm tracking-wider uppercase"
                      style="background: rgba(139,90,43,0.2); color: var(--clr-accent-light);"
                    >
                      Próximamente
                    </span>
                  )}
                </span>
              </div>
            ))
          }
        </div>

        <blockquote class="border-l-2 pl-4 py-1 mt-8" style="border-color: var(--clr-accent);">
          <p
            class="text-lg italic leading-snug mb-3"
            style="color: rgba(245,239,230,0.9); font-family: 'Cormorant Garamond', serif;"
          >
            "Invertir en la organización de tu empresa hoy, es garantizar un futuro prolijo y
            rentable para mañana."
          </p>
          <footer
            class="text-xs tracking-widest uppercase"
            style="color: var(--clr-accent-light); font-family: 'DM Sans', sans-serif;"
          >
            — Ezequiel Saucedo <span style="opacity: 0.6; font-weight: 300;"
              >| Founder, ByteSyncs</span
            >
          </footer>
        </blockquote>
      </div>

      <div class="relative z-10 pt-12">
        <div class="w-12 h-px mb-4" style="background: var(--clr-accent); opacity: 0.5;"></div>
        <p
          class="text-xs"
          style="color: rgba(245,239,230,0.3); font-family: 'DM Sans', sans-serif;"
        >
          © {new Date().getFullYear()} ByteSyncs · Elevando la gastronomía
        </p>
      </div>
    </aside>

    <section
      class="flex flex-col justify-center items-center px-6 py-16 sm:px-12 lg:px-16 xl:px-24"
    >
      <div class="w-full max-w-md">
        <div class="flex items-center gap-2 mb-10 lg:hidden">
          <div
            class="w-7 h-7 rounded-sm flex items-center justify-center"
            style="background: var(--clr-accent);"
          >
            <svg width="14" height="14" viewBox="0 0 16 16" fill="none">
              <rect x="2" y="2" width="5" height="5" rx="1" fill="#f5efe6"></rect>
              <rect x="9" y="2" width="5" height="5" rx="1" fill="#f5efe6" opacity="0.6"></rect>
              <rect x="2" y="9" width="5" height="5" rx="1" fill="#f5efe6" opacity="0.6"></rect>
              <rect x="9" y="9" width="5" height="5" rx="1" fill="#f5efe6"></rect>
            </svg>
          </div>
          <span
            class="text-sm tracking-widest uppercase"
            style="color: var(--clr-accent); font-family: 'DM Sans', sans-serif;"
          >
            ByteSyncs
          </span>
        </div>

        <LoginForm client:load />
      </div>
    </section>
  </main>
</AuthLayout>
