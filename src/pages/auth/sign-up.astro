---
import AuthLayout from '../../layouts/AuthLayout.astro'
import { getPlanMeta } from '../../libs/register'

const planParam = Astro.url.searchParams.get('plan')
const plan = getPlanMeta(planParam)
---

<AuthLayout
  title={`Crear cuenta — Essenz`}
  description="Creá una cuenta para tu negocio gastronómico en Essenz."
>
  <div class="min-h-screen relative flex items-center justify-center overflow-hidden">
    <div class="fixed inset-0 pointer-events-none z-0 opacity-[0.025] bg-noise"></div>

    <main class="relative z-10 w-full max-w-120 px-6 py-10">
      <div class="animate-fade-up">
        <div
          class="mb-6 inline-flex items-center gap-2 border border-(--clr-accent)/20 bg-(--clr-accent)/10 px-3 py-1.5"
        >
          <span class="inline-block size-1.5 rounded-full bg-(--clr-accent)"></span>
          <span
            class="font-family-name:--font-ui text-[0.72rem] text-(--clr-accent) font-medium tracking-widest uppercase"
          >
            {plan.name} · {plan.price ? `USD $${plan.price} / mes` : 'Consultar'}
          </span>
        </div>

        <h1
          class="font-family-name:--font-display text-[clamp(2rem,5vw,2.5rem)] leading-[1.1] text-(--clr-ink-dark) mb-4 tracking-tight"
        >
          Empezá por tu negocio.
        </h1>
        <p
          class="font-family-name:--font-body text-[1rem] leading-relaxed text-(--clr-ink)/60 mb-10 max-w-100"
        >
          Creá la cuenta y verificá tu correo. Después continuarás al pago del plan seleccionado.
        </p>

        <form id="register-form" novalidate class="flex flex-col gap-4" autocomplete="on">
          <div class="grid grid-cols-1 gap-3 sm:grid-cols-2">
            <div class="flex flex-col gap-1.5">
              <label
                for="ownerName"
                class="font-family-name:--font-ui text-[0.72rem] font-medium uppercase tracking-[0.06em] text-(--clr-ink)/50"
                >Tu nombre</label
              >
              <input
                type="text"
                id="ownerName"
                name="ownerName"
                placeholder="Ezequiel Saucedo"
                required
                data-error-for="client_name"
                aria-describedby="err-client_name"
                aria-invalid="false"
                class="w-full border border-(--clr-ink)/14 bg-(--clr-white)/80 px-4 py-3.5 text-[0.9375rem] font-family-name:--font-body text-(--clr-ink-dark) outline-none transition-[border-color,box-shadow] focus:border-(--clr-accent) focus:ring-2 focus:ring-(--clr-accent)/10 aria-invalid:border-red-600"
              />
              <span
                id="err-client_name"
                role="alert"
                class="hidden text-[0.65rem] text-red-500 font-medium uppercase"
                >Campo requerido</span
              >
            </div>
            <div class="flex flex-col gap-1.5">
              <label
                for="businessName"
                class="font-family-name:--font-ui text-[0.72rem] font-medium uppercase tracking-[0.06em] text-(--clr-ink)/50"
                >Tu negocio</label
              >
              <input
                type="text"
                id="businessName"
                name="businessName"
                placeholder="Café del Centro"
                required
                data-error-for="company_name"
                aria-describedby="err-company_name"
                aria-invalid="false"
                class="w-full border border-(--clr-ink)/14 bg-(--clr-white)/80 px-4 py-3.5 text-[0.9375rem] font-family-name:--font-body text-(--clr-ink-dark) outline-none transition-[border-color,box-shadow] focus:border-(--clr-accent) focus:ring-2 focus:ring-(--clr-accent)/10 aria-invalid:border-red-600"
              />
              <span
                id="err-company_name"
                role="alert"
                class="hidden text-[0.65rem] text-red-500 font-medium uppercase"
                >Campo requerido</span
              >
            </div>
          </div>

          <div class="flex flex-col gap-1.5">
            <label
              for="email"
              class="font-family-name:--font-ui text-[0.72rem] font-medium uppercase tracking-[0.06em] text-(--clr-ink)/50"
              >Email</label
            >
            <input
              type="email"
              id="email"
              name="email"
              placeholder="hola@tucafe.com"
              autocomplete="email"
              required
              data-error-for="email"
              aria-describedby="err-email"
              aria-invalid="false"
              class="w-full border border-(--clr-ink)/14 bg-(--clr-white)/80 px-4 py-3.5 text-[0.9375rem] font-family-name:--font-body text-(--clr-ink-dark) outline-none transition-[border-color,box-shadow] focus:border-(--clr-accent) focus:ring-2 focus:ring-(--clr-accent)/10 aria-invalid:border-red-600"
            />
            <span
              id="err-email"
              role="alert"
              class="hidden text-[0.65rem] text-red-500 font-medium uppercase">Email inválido</span
            >
          </div>

          <div class="flex flex-col gap-1.5">
            <label
              for="password"
              class="font-family-name:--font-ui text-[0.72rem] font-medium uppercase tracking-[0.06em] text-(--clr-ink)/50"
              >Contraseña</label
            >
            <input
              type="password"
              id="password"
              name="password"
              placeholder="Mínimo 8 caracteres"
              required
              data-error-for="password"
              aria-describedby="err-password"
              aria-invalid="false"
              class="w-full border border-(--clr-ink)/14 bg-(--clr-white)/80 px-4 py-3.5 text-[0.9375rem] font-family-name:--font-body text-(--clr-ink-dark) outline-none transition-[border-color,box-shadow] focus:border-(--clr-accent) focus:ring-2 focus:ring-(--clr-accent)/10 aria-invalid:border-red-600"
            />
            <span
              id="err-password"
              role="alert"
              class="hidden text-[0.65rem] text-red-500 font-medium uppercase"
              >Contraseña demasiado corta</span
            >
          </div>

          <div
            id="global-error"
            class="hidden px-4 py-3 text-sm text-red-600 bg-red-50 border border-red-100 mt-2"
          >
          </div>

          <button
            type="submit"
            id="submit-btn"
            class="w-full bg-(--clr-ink-dark) text-(--clr-bg) py-4 font-bold uppercase tracking-widest hover:bg-(--clr-accent) transition-colors duration-300 mt-2 active:scale-[0.98]"
          >
            <span id="btn-text">Crear mi cuenta</span>
          </button>

          <input type="hidden" id="plan-input" name="plan" value={plan.id} />
        </form>

        <p class="mt-10 text-center text-[0.8rem] text-(--clr-ink)/40 font-family-name:--font-body">
          ¿Ya tenés cuenta? <a
            href="/auth/sign-in"
            class="text-(--clr-ink-dark) font-bold underline underline-offset-4 decoration-(--clr-accent)/30 hover:decoration-(--clr-accent) transition-colors"
            >Iniciá sesión</a
          >
        </p>
      </div>
    </main>
  </div>
</AuthLayout>

<style>
  .bg-noise {
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 512 512' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)'/%3E%3C/svg%3E");
    background-size: 200px 200px;
  }

  @keyframes fadeUp {
    from {
      opacity: 0;
      transform: translateY(0.5rem);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .animate-fade-up {
    animation: fadeUp 240ms cubic-bezier(0.23, 1, 0.32, 1) both;
  }
</style>

<script>
  import {
    evaluatePasswordStrength,
    validateRegisterForm,
    submitRegister,
    getPlanMeta,
  } from '../../libs/register'
  import { errorMessages } from '../../libs/errorMessages'

  const showError = (id: string, show: boolean) => {
    const el = document.getElementById(`err-${id}`)
    const input = document.querySelector<HTMLInputElement>(`[data-error-for="${id}"]`)

    if (el) el.classList.toggle('hidden', !show)
    input?.setAttribute('aria-invalid', String(show))
  }

  const setLoading = (loading: boolean) => {
    const btn = document.getElementById('submit-btn') as HTMLButtonElement
    const text = document.getElementById('btn-text')

    if (btn && text) {
      btn.disabled = loading
      text.textContent = loading ? 'Procesando...' : 'Crear mi cuenta'
      btn.style.opacity = loading ? '0.7' : '1'
    }
  }

  const passwordInput = document.getElementById('password') as HTMLInputElement

  passwordInput?.addEventListener('input', () => {
    evaluatePasswordStrength(passwordInput.value)
  })

  const form = document.getElementById('register-form') as HTMLFormElement

  form?.addEventListener('submit', async (e) => {
    e.preventDefault()

    document.querySelectorAll('[id^="err-"]').forEach((el) => el.classList.add('hidden'))
    document.querySelectorAll<HTMLInputElement>('[data-error-for]').forEach((input) => {
      input.setAttribute('aria-invalid', 'false')
    })

    const globalError = document.getElementById('global-error')

    if (globalError) {
      globalError.classList.add('hidden')
      globalError.textContent = ''
    }

    const formData = new FormData(form)
    const entry = Object.fromEntries(formData.entries())

    const confirmPassword = (document.getElementById('confirmPassword') as HTMLInputElement)?.value

    const planId = entry.plan as string

    const data = {
      client_name: entry.ownerName as string,
      company_name: entry.businessName as string,
      email: entry.email as string,
      password: entry.password as string,
      plan_id: getPlanMeta(planId).id,
    }

    const validationErrors = validateRegisterForm(data)
    if (confirmPassword && data.password !== confirmPassword) {
      validationErrors.confirmPassword = 'Las contraseñas no coinciden.'
    }

    if (Object.keys(validationErrors).length > 0) {
      Object.keys(validationErrors).forEach((key) => showError(key, true))

      return
    }

    setLoading(true)

    try {
      const { ok, data: responseData } = await submitRegister(data)

      if (!ok) {
        if (globalError) {
          if (responseData.errors) {
            const errMsg = responseData.errors.map((e) => e.message)
            globalError.textContent = errMsg.join(', ')
            globalError.classList.remove('hidden')
            return
          }

          const translatedError =
            errorMessages[responseData.error as keyof typeof errorMessages] ||
            'Error en el registro'

          globalError.textContent = translatedError
          globalError.classList.remove('hidden')
        }

        return
      }

      sessionStorage.setItem('pending_verification_email', data.email)
      sessionStorage.setItem('pending_verification_plan', planId)
      window.location.href = `/auth/verify-email`
    } catch (err) {
      if (globalError) {
        globalError.textContent = 'Error de conexión. Intenta de nuevo.'

        globalError.classList.remove('hidden')
      }
    } finally {
      setLoading(false)
    }
  })
</script>
