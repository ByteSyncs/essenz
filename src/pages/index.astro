---
import '../styles/global.css'
import Nav from '../components/react/Nav.tsx'
import Hero from '../components/react/Hero.tsx'
import Testimonials from '../components/react/Testimonials.tsx'
import Pricing from '../components/react/Pricing.tsx'
import Demos from '../components/react/Demos.tsx'
import CtaFinal from '../components/react/CtaFinal.tsx'
import Footer from '../components/react/Footer.tsx'
import Layout from '../layouts/Layout.astro'
import BackToTop from '../components/react/BackToTop'
---

<Layout
  title="Essenz | La identidad digital que tu café merece"
  description="Lleva tu cafetería al siguiente nivel con el ecosistema de software de ByteSyncs. Despliegue profesional en 48hs."
>
  <Nav client:load />
  <BackToTop client:load />
  <main>
    <Hero client:load />
    <Testimonials client:visible />
    <Demos client:load />
    <Pricing client:visible />
    <CtaFinal client:visible />
  </main>
  <Footer client:visible />
</Layout>
