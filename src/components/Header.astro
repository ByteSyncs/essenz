---
interface Props {
  theme?: 'modern' | 'minimalist'
  logo?: string
  name?: string
  tagline?: string
  city?: string | null
  phone?: string | null
  openingHours?: string | null
}

const { theme = 'modern', logo, name, tagline, city, phone, openingHours } = Astro.props
const isMin = theme === 'minimalist'

const pathname = Astro.url.pathname
const menuUrl = pathname + '/menu'
const phoneHref = phone ? `tel:${phone.replace(/[^\d+]/g, '')}` : null

const navItems = [
  { label: 'Inicio', href: '#home' },
  { label: 'Variedades', href: '#varieties' },
  { label: 'Contacto', href: '#contact' },
]
---

<header
  id="main-header"
  class:list={[
    'fixed top-0 left-0 w-full z-50 transition-all duration-500 ease-in-out border-b',
    isMin ? 'bg-white/95 border-black/8' : 'bg-[#F5EFE6]/95 border-[#2C1E16]/10',
  ]}
>
  {
    !isMin && (
      <div
        id="top-strip"
        class="bg-[#2C1E16] text-[#F5EFE6]/70 overflow-hidden transition-all duration-500 h-9"
      >
        <div class="max-w-7xl mx-auto px-8 h-full flex justify-between items-center text-[10px] tracking-[0.25em] uppercase font-bold">
          <div class="flex min-w-0 gap-5">
            {openingHours && <span class="truncate">{openingHours}</span>}
            {city && <span class="hidden truncate lg:inline-block">{city}</span>}
          </div>
          {phoneHref && (
            <a href={phoneHref} class="hover:text-white transition-colors no-underline">
              {phone}
            </a>
          )}
        </div>
      </div>
    )
  }

  {
    isMin && (
      <div id="min-ticker" class="overflow-hidden h-8 bg-black">
        <div class="min-ticker-track flex items-center h-full gap-0 whitespace-nowrap">
          {Array(6)
            .fill(null)
            .map(() => (
              <span class="inline-flex items-center gap-6 px-8 text-[10px] tracking-[0.3em] uppercase text-white/50 font-bold shrink-0">
                <span class="text-[--clr-accent]">+</span>
                Sitio de {name}
                <span class="text-white/20">.</span>
                Carta digital
                <span class="text-white/20">.</span>
                Productos y ofertas
                <span class="text-white/20">.</span>
                {city || 'Información del local'}
              </span>
            ))}
        </div>
      </div>
    )
  }

  <div
    id="header-container"
    class:list={[
      'mx-auto px-6 md:px-12 flex justify-between items-center transition-all duration-500',
      isMin ? 'py-6 max-w-none' : 'py-3 max-w-7xl',
    ]}
  >
    <div class="flex-1 lg:flex-none">
      <a href={pathname} class="group flex items-center gap-4 no-underline">
        {
          logo ? (
            <img
              src={logo}
              alt={name}
              loading="eager"
              fetchpriority="high"
              decoding="sync"
              width="160"
              height="80"
              class:list={[
                'transition-all duration-500 group-hover:scale-105 object-contain',
                isMin ? 'h-10 w-auto' : 'h-18 w-auto',
              ]}
            />
          ) : isMin ? (
            <div class="flex items-center gap-3">
              <span class="w-5 h-5 bg-(--clr-accent) shrink-0 transition-transform duration-300 group-hover:rotate-45" />
              <span class="text-xl font-bold tracking-[-0.04em] text-black leading-none">
                {name}
              </span>
            </div>
          ) : (
            <div class="flex flex-col">
              <span class="font-bold tracking-tighter leading-none text-4xl text-[#2C1E16]">
                {name}
              </span>
              <span class="text-[11px] tracking-[0.35em] uppercase text-[#2C1E16]/60 mt-1.5 font-bold">
                {tagline}
              </span>
            </div>
          )
        }
      </a>
    </div>

    <nav class="hidden md:flex items-center gap-10">
      {
        navItems.map(({ label, href }) =>
          isMin ? (
            <a
              href={href}
              class="text-[11px] tracking-[0.25em] uppercase no-underline transition-all duration-200 text-black/50 hover:text-black font-bold py-2"
            >
              {label}
            </a>
          ) : (
            <a
              href={href}
              class="text-[12px] tracking-[0.2em] uppercase no-underline transition-all duration-300 relative group py-2 font-bold text-[#2C1E16]/80"
            >
              {label}
              <span class="absolute bottom-0 left-0 w-0 h-0.5 bg-[#C8A882] transition-all duration-300 group-hover:w-full" />
            </a>
          ),
        )
      }

      {
        isMin ? (
          <a
            href={menuUrl}
            class="inline-flex items-center gap-2.5 px-6 py-2.5 text-[11px] tracking-[0.25em] uppercase no-underline font-bold border border-black text-black hover:bg-black hover:text-white transition-all duration-200"
          >
            <span>Ver Carta</span>
            <svg width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true">
              <path
                d="M2 6h8M6.5 2.5L10 6l-3.5 3.5"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linecap="round"
                stroke-linejoin="round"
              />
            </svg>
          </a>
        ) : (
          <a
            href={menuUrl}
            class="inline-flex items-center gap-3 px-8 py-3.5 text-[11px] tracking-[0.25em] uppercase no-underline transition-all duration-500 font-bold bg-[#2C1E16] text-[#F5EFE6] hover:bg-[#C8A882] hover:text-[#2C1E16]"
          >
            <span>Ver Carta</span>
            <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
              <path
                d="M3 8h10M9 4l4 4-4 4"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              />
            </svg>
          </a>
        )
      }
    </nav>

    <button
      id="mobile-menu-btn"
      class="md:hidden relative z-110 flex flex-col justify-center items-end gap-1.25 w-10 h-10 p-2"
      aria-label="Abrir menu"
      aria-expanded="false"
    >
      <span
        class:list={[
          'block h-0.5 rounded-full transition-all duration-300 origin-center hb-top',
          isMin ? 'bg-black w-6' : 'bg-[#2C1E16] w-6',
        ]}></span>
      <span
        class:list={[
          'block h-0.5 rounded-full transition-all duration-300 hb-mid',
          isMin ? 'bg-black w-4' : 'bg-[#2C1E16] w-4',
        ]}></span>
      <span
        class:list={[
          'block h-0.5 rounded-full transition-all duration-300 origin-center hb-bot',
          isMin ? 'bg-black w-6' : 'bg-[#2C1E16] w-6',
        ]}></span>
    </button>
  </div>
</header>

<div
  id="mobile-menu"
  class:list={[
    'fixed top-0 left-0 w-full z-200 flex flex-col overflow-hidden',
    isMin ? 'bg-white' : 'bg-[#F5EFE6]',
  ]}
  aria-hidden="true"
>
  <div
    class:list={[
      'flex items-center justify-between px-6 shrink-0',
      isMin ? 'h-18.25 border-b border-black/8' : 'h-22',
    ]}
  >
    <a href="/" class="group flex items-center gap-3 no-underline">
      {
        logo ? (
          <img
            src={logo}
            alt={name}
            class:list={['object-contain', isMin ? 'h-9 w-auto' : 'h-14 w-auto']}
          />
        ) : isMin ? (
          <div class="flex items-center gap-3">
            <span class="w-4 h-4 bg-(--clr-accent) shrink-0" />
            <span class="text-lg font-bold tracking-[-0.04em] text-black leading-none">{name}</span>
          </div>
        ) : (
          <div class="flex flex-col">
            <span class="font-bold tracking-tighter leading-none text-3xl text-[#2C1E16]">
              {name}
            </span>
            {tagline && (
              <span class="text-[10px] tracking-[0.3em] uppercase text-[#2C1E16]/50 mt-1 font-bold">
                {tagline}
              </span>
            )}
          </div>
        )
      }
    </a>

    <button
      id="mobile-menu-close"
      class:list={[
        'w-10 h-10 flex items-center justify-center transition-colors duration-200',
        isMin ? 'hover:bg-black/5' : 'hover:bg-[#2C1E16]/8',
      ]}
      aria-label="Cerrar menu"
    >
      <svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true">
        <path
          d="M4 4l12 12M16 4L4 16"
          stroke={isMin ? 'black' : '#2C1E16'}
          stroke-width="1.5"
          stroke-linecap="round"></path>
      </svg>
    </button>
  </div>

  <nav class="flex flex-col flex-1 px-6 justify-center">
    {
      navItems.map(({ label, href }, i) =>
        isMin ? (
          <a
            href={href}
            class="group flex items-center justify-between py-5 border-b border-black/8 no-underline mobile-nav-item"
            style={`--delay: ${i * 60}ms`}
          >
            <span class="text-[2.5rem] font-bold text-black tracking-[-0.04em] group-hover:text-(--clr-accent) transition-colors duration-200 leading-none">
              {label}
            </span>
            <svg
              width="18"
              height="18"
              viewBox="0 0 20 20"
              fill="none"
              aria-hidden="true"
              class="text-black/20 group-hover:text-(--clr-accent) transition-colors duration-200 shrink-0"
            >
              <path
                d="M4 10h12M10 4l6 6-6 6"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linecap="round"
                stroke-linejoin="round"
              />
            </svg>
          </a>
        ) : (
          <a
            href={href}
            class="group flex items-center justify-between py-5 border-b border-[#2C1E16]/8 no-underline mobile-nav-item"
            style={`--delay: ${i * 60}ms`}
          >
            <span class="text-[2.5rem] font-bold text-[#2C1E16] tracking-tighter group-hover:text-[#C8A882] transition-colors duration-300 leading-none">
              {label}
            </span>
            <svg
              width="18"
              height="18"
              viewBox="0 0 20 20"
              fill="none"
              aria-hidden="true"
              class="text-[#2C1E16]/20 group-hover:text-[#C8A882] transition-colors duration-300 shrink-0"
            >
              <path
                d="M4 10h12M10 4l6 6-6 6"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linecap="round"
                stroke-linejoin="round"
              />
            </svg>
          </a>
        ),
      )
    }

    <a
      href={menuUrl}
      class:list={[
        'mt-8 flex items-center justify-center gap-3 py-4 text-[11px] tracking-[0.25em] uppercase no-underline font-bold transition-all duration-300 mobile-nav-item',
        isMin
          ? 'border border-black text-black hover:bg-black hover:text-white'
          : 'bg-[#2C1E16] text-[#F5EFE6] hover:bg-[#C8A882] hover:text-[#2C1E16]',
      ]}
      style={`--delay: ${navItems.length * 60}ms`}
    >
      <span>Ver Carta</span>
      <svg width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true">
        <path
          d="M3 8h10M9 4l4 4-4 4"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"></path>
      </svg>
    </a>
  </nav>

  <div
    class:list={[
      'px-6 py-6 shrink-0 flex items-center gap-6 border-t',
      isMin ? 'border-black/8' : 'border-[#2C1E16]/8',
    ]}
  >
    {
      phoneHref && (
        <a
          href={phoneHref}
          class:list={[
            'text-[10px] tracking-[0.2em] uppercase no-underline font-bold transition-colors',
            isMin ? 'text-black/40 hover:text-black' : 'text-[#2C1E16]/40 hover:text-[#2C1E16]',
          ]}
        >
          {phone}
        </a>
      )
    }
    {
      phoneHref && openingHours && (
        <span class:list={['w-px h-4', isMin ? 'bg-black/15' : 'bg-[#2C1E16]/15']} />
      )
    }
    {
      openingHours && (
        <span
          class:list={[
            'text-[10px] tracking-[0.12em] uppercase font-bold',
            isMin ? 'text-black/30' : 'text-[#2C1E16]/30',
          ]}
        >
          {openingHours}
        </span>
      )
    }
  </div>
</div>

<style>
  #main-header {
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
  }

  .min-ticker-track {
    animation: ticker 28s linear infinite;
    will-change: transform;
  }
  @media (prefers-reduced-motion: reduce) {
    .min-ticker-track {
      animation: none;
    }
  }
  @keyframes ticker {
    0% {
      transform: translateX(0);
    }
    100% {
      transform: translateX(-50%);
    }
  }

  #mobile-menu {
    height: 100dvh;
    visibility: hidden;
    opacity: 0;
    transform: translateX(100%);
    overflow: hidden;
    transition:
      opacity 0.35s cubic-bezier(0.22, 1, 0.36, 1),
      transform 0.35s cubic-bezier(0.22, 1, 0.36, 1),
      visibility 0s linear 0.35s;
  }

  @supports not (height: 100dvh) {
    #mobile-menu {
      height: 100vh;
    }
  }

  #mobile-menu.is-open {
    visibility: visible;
    opacity: 1;
    transform: translateX(0);
    transition:
      opacity 0.35s cubic-bezier(0.22, 1, 0.36, 1),
      transform 0.35s cubic-bezier(0.22, 1, 0.36, 1),
      visibility 0s linear 0s;
  }

  .mobile-nav-item {
    opacity: 0;
    transform: translateY(16px);
    transition:
      opacity 0.3s ease,
      transform 0.3s ease;
    transition-delay: var(--delay, 0ms);
  }
  #mobile-menu.is-open .mobile-nav-item {
    opacity: 1;
    transform: translateY(0);
  }

  .hb-top,
  .hb-bot {
    transition:
      transform 0.3s ease,
      width 0.3s ease;
  }
  .hb-mid {
    transition:
      opacity 0.2s ease,
      width 0.3s ease;
  }
  #mobile-menu-btn.is-open .hb-top {
    transform: translateY(7px) rotate(45deg);
    width: 24px !important;
  }
  #mobile-menu-btn.is-open .hb-mid {
    opacity: 0;
  }
  #mobile-menu-btn.is-open .hb-bot {
    transform: translateY(-7px) rotate(-45deg);
    width: 24px !important;
  }
</style>

<script>
  ;(() => {
    const header = document.getElementById('main-header')
    const container = document.getElementById('header-container')
    const strip = document.getElementById('top-strip')
    const ticker = document.getElementById('min-ticker')
    const menuBtn = document.getElementById('mobile-menu-btn') as HTMLButtonElement | null
    const menuClose = document.getElementById('mobile-menu-close')
    const mobileMenu = document.getElementById('mobile-menu')

    if (!header || !menuBtn || !mobileMenu) return

    window.addEventListener(
      'scroll',
      () => {
        const y = window.scrollY
        const isScrolled = y > 30

        if (isScrolled) {
          container?.classList.add('py-3')
          container?.classList.remove('py-5', 'py-6')
          if (strip) {
            strip.style.height = '0'
            strip.style.opacity = '0'
          }
          if (ticker) {
            ticker.style.height = '0'
            ticker.style.opacity = '0'
          }
          header.style.boxShadow = '0 1px 0 rgba(0,0,0,0.08)'
        } else {
          container?.classList.remove('py-3')
          container?.classList.add(header.classList.contains('bg-white/95') ? 'py-5' : 'py-6')
          if (strip) {
            strip.style.height = '36px'
            strip.style.opacity = '1'
          }
          if (ticker) {
            ticker.style.height = '32px'
            ticker.style.opacity = '1'
          }
          header.style.boxShadow = 'none'
        }
      },
      { passive: true },
    )

    let isOpen = false

    const openMenu = () => {
      isOpen = true
      mobileMenu.classList.add('is-open')
      mobileMenu.setAttribute('aria-hidden', 'false')
      menuBtn.classList.add('is-open')
      menuBtn.setAttribute('aria-expanded', 'true')
      menuBtn.setAttribute('aria-label', 'Cerrar menu')
      document.body.style.overflow = 'hidden'
    }

    const closeMenu = () => {
      isOpen = false
      mobileMenu.classList.remove('is-open')
      mobileMenu.setAttribute('aria-hidden', 'true')
      menuBtn.classList.remove('is-open')
      menuBtn.setAttribute('aria-expanded', 'false')
      menuBtn.setAttribute('aria-label', 'Abrir menu')
      document.body.style.overflow = ''
    }

    menuBtn.addEventListener('click', () => (isOpen ? closeMenu() : openMenu()))
    menuClose?.addEventListener('click', closeMenu)
    mobileMenu.querySelectorAll('a').forEach((l) => l.addEventListener('click', closeMenu))

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && isOpen) closeMenu()
    })
  })()
</script>
