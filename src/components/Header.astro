<header id="main-header" class="fixed w-full z-50 bg-(--clr-bg) transition-all duration-300">
  <div
    id="top-strip"
    class="bg-(--clr-ink-dark) text-(--clr-bg) overflow-hidden transition-all duration-400 h-8.5"
  >
    <div class="max-w-7xl mx-auto px-8 h-full flex justify-between items-center">
      <div
        class="flex gap-6 text-[10.5px] tracking-widest uppercase text-(--clr-bg)/60 whitespace-nowrap font-['DM_Sans',system-ui,sans-serif]"
      >
        <span class="flex items-center gap-1.5">
          <svg width="10" height="10" viewBox="0 0 12 12" fill="none">
            <circle cx="6" cy="6" r="5" stroke="currentColor" stroke-width="1" opacity="0.5"
            ></circle>
            <path
              d="M6 3v3l2 1.5"
              stroke="currentColor"
              stroke-width="1"
              stroke-linecap="round"
              opacity="0.5"></path>
          </svg>
          Lun–Vie 7:00–21:00
        </span>
        <span class="hidden sm:inline">Sáb–Dom 8:00–22:00</span>
        <span class="hidden md:inline">📍 Av. Entre Ríos, CABA</span>
      </div>
      <div
        class="flex gap-5 items-center text-[10.5px] tracking-widest uppercase font-['DM_Sans',system-ui,sans-serif]"
      >
        <span class="w-px h-3 bg-(--clr-bg)/20"></span>
        <a
          href="tel:+541140000000"
          class="text-(--clr-bg)/60 hover:text-(--clr-accent-light) transition-colors no-underline hidden sm:inline"
          >+54 9 11 1234-5678</a
        >
      </div>
    </div>
  </div>

  <div class="h-0.75 bg-(--clr-green)"></div>

  <div class="max-w-7xl mx-auto px-8 py-4.5 pb-3.5 flex justify-between items-center gap-6">
    <a href="/" class="flex flex-col items-start gap-0.5 no-underline group shrink-0">
      <span
        class="text-[8.5px] tracking-[0.22em] uppercase text-(--clr-ink)/60 font-medium font-['DM_Sans',system-ui,sans-serif]"
      >
        Est. 2024 · Buenos Aires
      </span>
      <span
        class="text-[28px] font-bold text-(--clr-ink-dark) leading-none tracking-tight flex items-center gap-2.5 group-hover:opacity-80 transition-opacity font-['Playfair_Display',Georgia,serif]"
      >
        <svg
          width="28"
          height="28"
          viewBox="0 0 100 100"
          fill="none"
          xmlns="http://www.w3.org/2000/svg"
          class="relative top-px shrink-0"
        >
          <path d="M20,40 C20,25 80,25 80,40 L75,75 C75,85 25,85 25,75 Z" fill="var(--clr-green)"
          ></path>
          <path
            d="M78,45 C88,45 88,65 78,65 L76,65"
            stroke="var(--clr-green)"
            stroke-width="6"
            stroke-linecap="round"></path>
          <path
            d="M35,25 C35,15 45,15 45,5"
            stroke="var(--clr-accent-light)"
            stroke-width="5"
            stroke-linecap="round"
            opacity="0.9"></path>
          <path
            d="M50,25 C50,10 60,10 60,0"
            stroke="var(--clr-accent-light)"
            stroke-width="5"
            stroke-linecap="round"
            opacity="0.7"></path>
          <path
            d="M65,25 C65,18 72,18 72,10"
            stroke="var(--clr-accent-light)"
            stroke-width="5"
            stroke-linecap="round"
            opacity="0.5"></path>
        </svg>
        ByteSyncs
      </span>
      <span
        class="text-[12px] italic text-(--clr-ink-dark)/60 font-['Cormorant_Garamond',Georgia,serif]"
      >
        Café de especialidad &amp; experiencias
      </span>
    </a>

    <div class="hidden lg:flex flex-col items-center gap-1.5 flex-1 max-w-70">
      <div class="w-full h-px bg-linear-to-r from-transparent via-(--clr-ink)/15 to-transparent">
      </div>
      <span
        class="text-[9px] tracking-[0.3em] uppercase text-(--clr-ink-dark)/60 whitespace-nowrap font-['Cormorant_Garamond',Georgia,serif]"
      >
        desde el grano hasta la taza
      </span>
      <div class="w-full h-px bg-linear-to-r from-transparent via-(--clr-ink)/15 to-transparent">
      </div>
    </div>

    <nav class="hidden md:flex items-center gap-8">
      <a
        href="/#inicio"
        class="relative text-[11.5px] tracking-[0.12em] uppercase text-(--clr-ink-dark)/60 no-underline font-normal transition-colors duration-200 hover:text-(--clr-ink-dark) font-['DM_Sans',system-ui,sans-serif] after:content-[''] after:absolute after:left-0 after:-bottom-0.75 after:w-0 after:h-px after:bg-(--clr-accent-light) after:transition-[width] after:duration-300 hover:after:w-full"
        >Inicio</a
      >
      <a
        href="/#variedades"
        class="relative text-[11.5px] tracking-[0.12em] uppercase text-(--clr-ink-dark)/60 no-underline font-normal transition-colors duration-200 hover:text-(--clr-ink-dark) font-['DM_Sans',system-ui,sans-serif] after:content-[''] after:absolute after:left-0 after:-bottom-0.75 after:w-0 after:h-px after:bg-(--clr-accent-light) after:transition-[width] after:duration-300 hover:after:w-full"
        >Variedades</a
      >
      <a
        href="/#contacto"
        class="relative text-[11.5px] tracking-[0.12em] uppercase text-(--clr-ink-dark)/60 no-underline font-normal transition-colors duration-200 hover:text-(--clr-ink-dark) font-['DM_Sans',system-ui,sans-serif] after:content-[''] after:absolute after:left-0 after:-bottom-0.75 after:w-0 after:h-px after:bg-(--clr-accent-light) after:transition-[width] after:duration-300 hover:after:w-full"
        >Contacto</a
      >

      <a
        href="/menu"
        class="relative inline-flex items-center gap-2 px-5.5 py-2.5 bg-(--clr-green) text-(--clr-bg) text-[10.5px] tracking-[0.18em] uppercase font-medium no-underline overflow-hidden transition-colors font-['DM_Sans',system-ui,sans-serif] group/cta"
      >
        <span
          class="absolute inset-0 bg-(--clr-accent-light) -translate-x-full transition-transform duration-350 ease-in-out group-hover/cta:translate-x-0"
        ></span>
        <span class="relative z-10">Ver Carta</span>
        <svg width="12" height="12" viewBox="0 0 16 16" fill="none" class="relative z-10">
          <path
            d="M3 8h10M9 4l4 4-4 4"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="round"
            stroke-linejoin="round"></path>
        </svg>
      </a>
    </nav>

    <button
      id="mobile-menu-btn"
      class="md:hidden border border-(--clr-ink-dark)/15 hover:border-(--clr-green) transition-colors w-9.5 h-9.5 flex flex-col items-center justify-center gap-1.25"
      aria-label="Abrir menú de navegación"
    >
      <span
        id="hb-1"
        class="block w-4 h-px bg-(--clr-ink-dark) transition-all duration-300 origin-center"></span>
      <span
        id="hb-2"
        class="block w-4 h-px bg-(--clr-ink-dark) transition-all duration-300 origin-center"></span>
      <span
        id="hb-3"
        class="block w-4 h-px bg-(--clr-ink-dark) transition-all duration-300 origin-center"></span>
    </button>
  </div>

  <div
    id="mobile-menu"
    class="hidden md:hidden border-t border-(--clr-ink-dark)/10 bg-(--clr-bg) px-8 pb-8 pt-7"
  >
    <nav class="flex flex-col">
      <a
        href="/#inicio"
        class="flex justify-between items-center py-3.5 border-b border-(--clr-ink-dark)/10 text-[22px] font-normal text-(--clr-ink-dark) no-underline transition-colors hover:text-(--clr-green) font-['Cormorant_Garamond',Georgia,serif]"
      >
        Inicio
        <svg width="14" height="14" viewBox="0 0 16 16" fill="none"
          ><path
            d="M5 8h6M8 5l3 3-3 3"
            stroke="currentColor"
            stroke-width="1.2"
            stroke-linecap="round"
            stroke-linejoin="round"></path></svg
        >
      </a>
      <a
        href="/#variedades"
        class="flex justify-between items-center py-3.5 border-b border-(--clr-ink-dark)/10 text-[22px] font-normal text-(--clr-ink-dark) no-underline transition-colors hover:text-(--clr-green) font-['Cormorant_Garamond',Georgia,serif]"
      >
        Variedades
        <svg width="14" height="14" viewBox="0 0 16 16" fill="none"
          ><path
            d="M5 8h6M8 5l3 3-3 3"
            stroke="currentColor"
            stroke-width="1.2"
            stroke-linecap="round"
            stroke-linejoin="round"></path></svg
        >
      </a>
      <a
        href="/#contacto"
        class="flex justify-between items-center py-3.5 border-b border-(--clr-ink-dark)/10 text-[22px] font-normal text-(--clr-ink-dark) no-underline transition-colors hover:text-(--clr-green) font-['Cormorant_Garamond',Georgia,serif]"
      >
        Contacto
        <svg width="14" height="14" viewBox="0 0 16 16" fill="none"
          ><path
            d="M5 8h6M8 5l3 3-3 3"
            stroke="currentColor"
            stroke-width="1.2"
            stroke-linecap="round"
            stroke-linejoin="round"></path></svg
        >
      </a>
      <a
        href="/menu"
        class="mt-6 block text-center bg-(--clr-green) text-(--clr-bg) py-3.5 text-[11px] tracking-[0.2em] uppercase font-medium no-underline hover:bg-(--clr-accent-light) transition-colors font-['DM_Sans',system-ui,sans-serif]"
      >
        Ver Carta Completa →
      </a>
    </nav>
  </div>

  <div class="flex items-center px-8">
    <div class="flex-1 h-px bg-(--clr-ink-dark)/10"></div>
    <div class="w-0.75 h-0.75 rounded-full bg-(--clr-ink-dark)/15 mx-2"></div>
    <div class="w-1.25 h-1.25 bg-(--clr-accent-light) mx-2.5 rotate-45 opacity-60"></div>
    <div class="w-0.75 h-0.75 rounded-full bg-(--clr-ink-dark)/15 mx-2"></div>
    <div class="flex-1 h-px bg-(--clr-ink-dark)/10"></div>
  </div>
</header>

<link rel="preconnect" href="https://fonts.googleapis.com" />
<link
  href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,700;1,400;1,500&family=Cormorant+Garamond:ital,wght@0,300;1,300;1,400&family=DM+Sans:wght@300;400;500&display=swap"
  rel="stylesheet"
/>

<script>
  ;(() => {
    const strip = document.getElementById('top-strip')
    const header = document.getElementById('main-header') as HTMLElement
    const menuBtn = document.getElementById('mobile-menu-btn')
    const mobileMenu = document.getElementById('mobile-menu')
    const hbs = [
      document.getElementById('hb-1'),
      document.getElementById('hb-2'),
      document.getElementById('hb-3'),
    ] as HTMLElement[]

    if (!strip || !header || !menuBtn || !mobileMenu) return

    window.addEventListener(
      'scroll',
      () => {
        const y = window.scrollY
        header.style.boxShadow = y > 10 ? '0 2px 40px rgba(26,18,11,0.10)' : 'none'
        if (y > 74) {
          strip.style.height = '0'
          strip.style.opacity = '0'
        } else {
          strip.style.height = '34px'
          strip.style.opacity = '1'
        }
      },
      { passive: true },
    )

    let isOpen = false
    const toggleMenu = () => {
      isOpen = !isOpen
      mobileMenu.classList.toggle('hidden', !isOpen)
      hbs[0].style.transform = isOpen ? 'translateY(6px) rotate(45deg)' : ''
      hbs[1].style.opacity = isOpen ? '0' : '1'
      hbs[2].style.transform = isOpen ? 'translateY(-6px) rotate(-45deg)' : ''
    }

    menuBtn.addEventListener('click', toggleMenu)
    window.addEventListener('click', (e) => {
      if (isOpen && !header.contains(e.target as Node)) toggleMenu()
    })
    mobileMenu
      .querySelectorAll('a')
      .forEach((link) => link.addEventListener('click', () => isOpen && toggleMenu()))
  })()
</script>
