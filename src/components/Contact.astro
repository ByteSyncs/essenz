---
const { theme, slug } = Astro.props
const isMin = theme === 'minimalist'
---

{
  !isMin ? (
    <section id="contact" class="py-20 bg-(--clr-dark) text-white">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-12 items-center">
          <div>
            <h2 class="text-3xl md:text-4xl font-bold mb-6">Encuéntranos</h2>
            <p class="text-gray-400 mb-8">
              Ven a disfrutar de una experiencia única. Te esperamos en nuestro local.
            </p>
            <div class="space-y-6">
              <div class="flex items-start gap-4">
                <span class="p-3 bg-(--clr-accent)/20 text-(--clr-accent) rounded-full shrink-0">
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    width="20"
                    height="20"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <>
                      <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z" />
                      <circle cx="12" cy="10" r="3" />
                    </>
                  </svg>
                </span>
                <div>
                  <p>Av. Entre Ríos, C1033</p>
                  <p class="text-sm text-gray-400">Cdad. Autónoma de Buenos Aires</p>
                </div>
              </div>
              <div class="flex items-center gap-4">
                <span class="p-3 bg-(--clr-accent)/20 text-(--clr-accent) rounded-full shrink-0">
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    width="20"
                    height="20"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z" />
                  </svg>
                </span>
                <p>+54 9 11 1234-5678</p>
              </div>
              <div class="flex items-center gap-4">
                <span class="p-3 bg-(--clr-accent)/20 text-(--clr-accent) rounded-full shrink-0">
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    width="20"
                    height="20"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <>
                      <rect width="20" height="16" x="2" y="4" rx="2" />
                      <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7" />
                    </>
                  </svg>
                </span>
                <p>contact@{slug}.com</p>
              </div>
            </div>
          </div>
          <div class="relative w-full h-80 overflow-hidden border border-(--clr-ink)/10 shadow-inner">
            <iframe
              src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d4100.444694626743!2d-58.39518102337317!3d-34.60981635782192!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x95bccac2cd859503%3A0x75cdafaaef2b946!2sCongreso%20de%20la%20Naci%C3%B3n%20Argentina!5e1!3m2!1sen!2sar!4v1775591879044!5m2!1sen!2sar"
              class="w-full h-full"
              style="border:0;"
              allowfullscreen=""
              loading="lazy"
              referrerpolicy="no-referrer-when-downgrade"
            />
          </div>
        </div>
      </div>
    </section>
  ) : (
    <section id="contacto" class="bg-black text-white">
      <div class="border-b border-white/8 px-6 md:px-12 py-5 flex items-center justify-between max-w-none">
        <span class="text-[10px] font-bold tracking-[0.35em] uppercase text-white/30">
          — Encuéntranos
        </span>
        <span class="text-[10px] font-bold tracking-[0.25em] uppercase text-white/20">
          Buenos Aires, AR
        </span>
      </div>
      <div class="grid grid-cols-1 lg:grid-cols-2 min-h-130">
        <div class="px-6 md:px-12 py-16 flex flex-col justify-between border-b lg:border-b-0 lg:border-r border-white/8">
          <div>
            <h2 class="text-[clamp(2.5rem,6vw,5rem)] font-bold tracking-[-0.04em] leading-[0.95] mb-12">
              Vení
              <br />
              <span class="text-(--clr-accent)">a vernos.</span>
            </h2>
            <div class="space-y-8">
              {[
                {
                  label: 'Dirección',
                  value: 'Av. Entre Ríos, C1033',
                  sub: 'CABA, Buenos Aires',
                },
                {
                  label: 'Teléfono',
                  value: '+54 9 11 1234-5678',
                  href: 'tel:+541140000000',
                },
                {
                  label: 'Email',
                  value: `contact@${slug}.com`,
                  href: `mailto:contact@${slug}.com`,
                },
                {
                  label: 'Horario',
                  value: 'Lunes – Domingo',
                  sub: '7:00 – 21:00 hs',
                },
              ].map(({ label, value, sub, href }) => (
                <div class="flex gap-6 items-start border-b border-white/6 pb-6 last:border-b-0">
                  <span class="text-[10px] font-bold tracking-[0.3em] uppercase text-white/25 w-20 shrink-0 mt-0.5">
                    {label}
                  </span>
                  <div>
                    {href ? (
                      <a
                        href={href}
                        class="block text-base font-bold text-white no-underline hover:text-(--clr-accent) transition-colors duration-200"
                      >
                        {value}
                      </a>
                    ) : (
                      <span class="block text-base font-bold text-white">{value}</span>
                    )}
                    {sub && <span class="block text-sm text-white/40 mt-0.5">{sub}</span>}
                  </div>
                </div>
              ))}
            </div>
          </div>
          <div class="mt-12">
            <a
              href={`mailto:contact@${slug}.com`}
              class="inline-flex items-center gap-3 px-8 py-4 border border-white/20 text-white no-underline text-[11px] tracking-[0.25em] uppercase font-bold hover:bg-white hover:text-black transition-all duration-200"
            >
              Escribinos
              <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
                <path
                  d="M2 7H12M8 3L12 7L8 11"
                  stroke="currentColor"
                  stroke-width="1.5"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                />
              </svg>
            </a>
          </div>
        </div>
        <div class="relative min-h-75 lg:min-h-0 overflow-hidden">
          <iframe
            src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d4100.444694626743!2d-58.39518102337317!3d-34.60981635782192!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x95bccac2cd859503%3A0x75cdafaaef2b946!2sCongreso%20de%20la%20Naci%C3%B3n%20Argentina!5e1!3m2!1sen!2sar!4v1775591879044!5m2!1sen!2sar"
            class="w-full h-full absolute inset-0 min-h-75 grayscale contrast-110 opacity-60"
            style="border:0;"
            allowfullscreen=""
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
          />
          <div class="absolute inset-0 bg-black/30 pointer-events-none" />
          <div class="absolute bottom-6 left-6 bg-black px-4 py-2 flex items-center gap-2">
            <span class="w-1.5 h-1.5 bg-(--clr-accent) animate-pulse" />
            <span class="text-[10px] font-bold tracking-[0.25em] uppercase text-white">
              Abierto ahora
            </span>
          </div>
        </div>
      </div>
    </section>
  )
}
