---
interface Props {
  theme?: 'modern' | 'minimalist'
  address?: string | null
  city?: string | null
  phone?: string | null
  email?: string | null
  openingHours?: string | null
  instagramUrl?: string | null
  facebookUrl?: string | null
}

const {
  theme = 'modern',
  address,
  city,
  phone,
  email,
  openingHours,
  instagramUrl,
  facebookUrl,
} = Astro.props
const isMin = theme === 'minimalist'
const location = [address, city].filter(Boolean).join(', ')
const mapUrl = location ? `https://maps.google.com/?q=${encodeURIComponent(location)}` : null
const phoneHref = phone ? `tel:${phone.replace(/[^\d+]/g, '')}` : null

function safeExternalUrl(value?: string | null) {
  if (!value) return null
  try {
    const url = new URL(value)
    return ['http:', 'https:'].includes(url.protocol) ? url.toString() : null
  } catch {
    return null
  }
}

const socials = [
  { label: 'Instagram', href: safeExternalUrl(instagramUrl) },
  { label: 'Facebook', href: safeExternalUrl(facebookUrl) },
].filter((social) => social.href)
const details = [
  { label: 'Dirección', value: location, href: mapUrl },
  { label: 'Teléfono', value: phone, href: phoneHref },
  { label: 'Email', value: email, href: email ? `mailto:${email}` : null },
  { label: 'Horarios', value: openingHours, href: null },
].filter((detail) => detail.value)
---

{
  isMin ? (
    <section id="contact" class="border-t border-black/10 bg-black text-white">
      <div class="mx-auto grid max-w-7xl gap-12 px-6 py-16 md:px-12 md:py-24 lg:grid-cols-[1fr_1fr]">
        <div>
          <span class="mb-5 block text-[10px] font-bold uppercase tracking-[0.3em] text-white/35">
            Contacto
          </span>
          <h2 class="text-[clamp(2.75rem,7vw,5.5rem)] font-bold leading-[0.9] tracking-[-0.05em]">
            Nos vemos
            <br />
            <span class="text-(--clr-accent)">en el local.</span>
          </h2>
          <div class="mt-10 flex flex-wrap gap-5 text-xs font-bold uppercase tracking-[0.15em]">
            {socials.map(({ label, href }) => (
              <a
                href={href}
                target="_blank"
                rel="noreferrer"
                class="text-white/70 underline underline-offset-4 hover:text-white"
              >
                {label}
              </a>
            ))}
            {mapUrl && (
              <a
                href={mapUrl}
                target="_blank"
                rel="noreferrer"
                class="text-white/70 underline underline-offset-4 hover:text-white"
              >
                Cómo llegar
              </a>
            )}
          </div>
        </div>
        <div class="border-t border-white/15 lg:border-t-0">
          {details.length ? (
            details.map(({ label, value, href }) => (
              <div class="grid grid-cols-[5rem_1fr] gap-4 border-b border-white/10 py-5 sm:grid-cols-[7rem_1fr]">
                <span class="pt-1 text-[9px] font-bold uppercase tracking-[0.2em] text-white/35">
                  {label}
                </span>
                {href ? (
                  <a
                    href={href}
                    class="text-sm leading-relaxed text-white/85 underline-offset-4 hover:underline sm:text-base"
                  >
                    {value}
                  </a>
                ) : (
                  <span class="text-sm leading-relaxed text-white/85 sm:text-base">{value}</span>
                )}
              </div>
            ))
          ) : (
            <p class="border-b border-white/10 py-5 text-sm leading-relaxed text-white/60">
              La información de contacto de este negocio todavía no está disponible.
            </p>
          )}
        </div>
      </div>
    </section>
  ) : (
    <section id="contact" class="bg-(--clr-dark) text-white">
      <div class="mx-auto grid max-w-7xl gap-12 px-5 py-16 sm:px-8 sm:py-20 lg:grid-cols-[0.8fr_1.2fr] lg:items-start">
        <div>
          <span class="mb-4 inline-flex items-center gap-3 text-[10px] font-bold uppercase tracking-[0.25em] text-(--clr-accent)">
            <span class="h-px w-8 bg-(--clr-accent)" />
            Contacto
          </span>
          <h2 class="max-w-xl text-4xl font-bold tracking-tight sm:text-5xl">
            Tu próximo encuentro empieza acá.
          </h2>
          <p class="mt-4 max-w-md text-sm leading-relaxed text-white/55">
            Consultá la ubicación, los horarios y las formas de comunicarte con el negocio.
          </p>
          <div class="mt-7 flex flex-wrap gap-5 text-xs font-bold uppercase tracking-[0.12em]">
            {socials.map(({ label, href }) => (
              <a
                href={href}
                target="_blank"
                rel="noreferrer"
                class="text-white/65 underline underline-offset-4 hover:text-white"
              >
                {label}
              </a>
            ))}
            {mapUrl && (
              <a
                href={mapUrl}
                target="_blank"
                rel="noreferrer"
                class="text-white/65 underline underline-offset-4 hover:text-white"
              >
                Cómo llegar
              </a>
            )}
          </div>
        </div>
        <div class="border-t border-white/15">
          {details.length ? (
            details.map(({ label, value, href }) => (
              <div class="grid grid-cols-[6rem_1fr] gap-4 border-b border-white/10 py-5 sm:grid-cols-[8rem_1fr]">
                <span class="pt-1 text-[9px] font-bold uppercase tracking-[0.2em] text-white/35">
                  {label}
                </span>
                {href ? (
                  <a
                    href={href}
                    class="text-sm leading-relaxed text-white/85 underline-offset-4 hover:underline sm:text-base"
                  >
                    {value}
                  </a>
                ) : (
                  <span class="text-sm leading-relaxed text-white/85 sm:text-base">{value}</span>
                )}
              </div>
            ))
          ) : (
            <p class="border-b border-white/10 py-5 text-sm leading-relaxed text-white/60">
              La información de contacto de este negocio todavía no está disponible.
            </p>
          )}
        </div>
      </div>
    </section>
  )
}
