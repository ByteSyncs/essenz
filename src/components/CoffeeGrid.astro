---
import type { MenuItem } from '../types/menu'

interface Props {
  theme?: 'modern' | 'minimalist'
  dataProducts: MenuItem[]
}

const { theme = 'modern', dataProducts } = Astro.props
const isMin = theme === 'minimalist'
const products = dataProducts.slice(0, 5)

const levels = ['Suave', 'Medio', 'Intenso', 'Fuerte', 'Muy fuerte']

const menuUrl = Astro.url.pathname + '/menu'
---

{
  !isMin ? (
    <section id="varieties" class="py-24 bg-(--clr-bg) text-(--clr-ink)">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="mb-20 flex flex-col lg:flex-row lg:items-end gap-10 lg:gap-20">
          <div class="flex-1">
            <div class="inline-flex items-center gap-3 mb-6">
              <div class="h-px w-10 bg-(--clr-green)" />
              <span class="text-xs font-medium tracking-[0.125em] uppercase text-(--clr-green)">
                Selección de temporada
              </span>
            </div>
            <h2 class="text-5xl md:text-6xl lg:text-7xl font-bold tracking-[-0.04em] leading-none">
              Nuestra
              <br />
              sugerencia
            </h2>
          </div>

          <div class="max-w-md text-(--clr-ink)/70 text-[17px] leading-relaxed">
            Granos seleccionados de las mejores fincas y tostados en nuestra casa para resaltar su
            perfil único.
            <a
              href={menuUrl}
              class="mt-8 inline-flex items-center gap-2 text-sm tracking-widest uppercase font-bold text-(--clr-accent) hover:text-(--clr-green) transition-colors"
            >
              Ver todo el catálogo →
            </a>
          </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-12 gap-6 auto-rows-[450px]">
          {products.map((coffee, index) => {
            const gridClasses = [
              'lg:col-span-8',
              'lg:col-span-4',
              'lg:col-span-4',
              'lg:col-span-4',
              'lg:col-span-4',
            ]
            const intensityName = levels[(coffee.intensity ?? 1) - 1] || coffee.intensity

            return (
              <div
                class={`coffee-card group relative overflow-hidden rounded-4xl bg-black isolate opacity-0 translate-y-12 transition-all duration-1000 ${gridClasses[index]}`}
                style={`transition-delay: ${index * 120}ms`}
                data-coffee-id={coffee.id}
              >
                <img
                  src={coffee.image_url}
                  alt={coffee.name}
                  class="absolute inset-0 w-full h-full object-cover transition-transform duration-1000 group-hover:scale-110 -z-10"
                  loading="lazy"
                />

                <div class="absolute inset-0 bg-linear-to-t from-black/90 via-black/30 to-black/10 opacity-80 group-hover:opacity-95 transition-opacity duration-500 -z-10" />

                <div class="relative h-full flex flex-col p-8 lg:p-10 justify-between">
                  <div class="flex items-center justify-between">
                    <span class="px-5 py-2 text-[10px] font-bold tracking-[0.2em] uppercase bg-white/10 backdrop-blur-md text-white rounded-full border border-white/20">
                      {intensityName}
                    </span>

                    <div class="flex gap-1.5">
                      {Array.from({ length: 5 }).map((_, i) => (
                        <div
                          class={`h-1.5 rounded-full transition-all duration-500 ${
                            i < (coffee.intensity ?? 0) ? 'bg-(--clr-green) w-6' : 'bg-white/20 w-2'
                          }`}
                        />
                      ))}
                    </div>
                  </div>

                  <div class="transform translate-y-8 group-hover:translate-y-0 transition-transform duration-700 ease-out">
                    <h3 class="text-3xl lg:text-4xl font-bold tracking-tight text-white mb-4">
                      {coffee.name}
                    </h3>

                    <p class="text-white/70 text-sm lg:text-base leading-relaxed line-clamp-2 max-w-lg opacity-0 group-hover:opacity-100 transition-opacity duration-700 delay-100 mb-6">
                      {coffee.details.notes}
                    </p>

                    <div class="flex items-center gap-4 text-[10px] font-mono uppercase tracking-[0.2em] text-white/50 border-t border-white/10 pt-6">
                      <span>Intensidad {coffee.intensity}/5</span>
                      <span class="w-1 h-1 rounded-full bg-(--clr-green)" />
                      <span>Origen Único</span>
                    </div>
                  </div>
                </div>
              </div>
            )
          })}
        </div>

        <div class="mt-20 flex items-center justify-center gap-6 text-[10px] tracking-[0.2em] text-(--clr-ink)/40 uppercase font-bold">
          <span>Tueste propio</span>
          <span class="w-1.5 h-1.5 rounded-full bg-(--clr-green)" />
          <span>Directo de finca</span>
          <span class="w-1.5 h-1.5 rounded-full bg-(--clr-green)" />
          <span>Temporada 2026</span>
        </div>
      </div>
    </section>
  ) : (
    <section id="varieties" class="py-24 bg-white border-t border-black/8">
      <div class="max-w-7xl mx-auto px-6 md:px-12">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-8 items-end mb-16 pb-10 border-b border-black/10">
          <div>
            <span class="block text-[10px] font-bold tracking-[0.35em] uppercase text-black/30 mb-4">
              — Selección de temporada
            </span>
            <h2 class="text-[clamp(2.25rem,5vw,4rem)] font-bold text-black tracking-[-0.03em] leading-[1.05]">
              Los mas
              <br />
              Elegidos
            </h2>
          </div>
          <div class="md:text-right">
            <p class="text-black/50 text-base leading-relaxed max-w-sm md:ml-auto">
              Seleccionados de las mejores fincas del mundo y tostados en nuestra casa para resaltar
              su perfil único.
            </p>
            <a
              href={menuUrl}
              class="inline-flex items-center gap-2 mt-6 text-[11px] tracking-[0.25em] uppercase font-bold text-black no-underline border-b border-black/30 pb-px hover:border-black hover:text-(--clr-accent) transition-colors duration-200"
            >
              Ver catálogo completo
              <svg width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true">
                <path
                  d="M2 6h8M6.5 2.5L10 6l-3.5 3.5"
                  stroke="currentColor"
                  stroke-width="1.5"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                />
              </svg>
            </a>
          </div>
        </div>

        <div class="space-y-0">
          {products.map((coffee, i) => (
            <div
              class="coffee-row group grid grid-cols-1 sm:grid-cols-[1fr_auto] lg:grid-cols-[auto_1fr_auto_auto] items-center gap-0 border-b border-black/8 py-6 lg:py-5 opacity-0 translate-y-4 transition-all duration-500 ease-out cursor-default"
              style={`transition-delay: ${i * 80}ms`}
              data-coffee-id={coffee.id}
            >
              <span class="hidden lg:block text-[11px] font-bold tracking-[0.2em] text-black/20 w-16 shrink-0 tabular-nums">
                0{i + 1}
              </span>

              <div class="min-w-0">
                <div class="flex items-baseline gap-3 flex-wrap">
                  <h3 class="text-xl lg:text-2xl font-bold text-black tracking-[-0.02em] group-hover:text-(--clr-accent) transition-colors duration-200">
                    {coffee.name}
                  </h3>
                </div>
                <p class="text-sm text-black/45 mt-0.5">{coffee.description}</p>
              </div>

              <div class="hidden sm:flex items-center gap-3 shrink-0 px-6">
                <div class="flex flex-row items-center justify-center gap-3">
                  <div class="flex gap-1 relative" aria-label={`Intensidad: ${coffee.intensity}`}>
                    {Array.from({ length: 5 }).map((_, li) => {
                      const lvl = coffee.intensity ?? 0
                      return (
                        <span
                          class:list={[
                            'w-4 h-1 transition-colors duration-200',
                            li < lvl ? 'bg-black group-hover:bg-(--clr-accent)' : 'bg-black/15',
                          ]}
                        />
                      )
                    })}
                  </div>

                  <span class="text-[10px] tracking-wide text-black/40 font-bold uppercase">
                    {levels[(coffee.intensity ?? 1) - 1] || coffee.intensity}
                  </span>
                </div>
              </div>

              <div class="hidden lg:block w-16 h-10 overflow-hidden shrink-0">
                <img
                  src={coffee.image_url}
                  alt={coffee.name}
                  class="w-full h-full object-cover grayscale group-hover:grayscale-0 group-hover:scale-110 transition-all duration-500"
                  loading="lazy"
                  width="64"
                  height="40"
                />
              </div>
            </div>
          ))}
        </div>

        <div class="mt-12 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
          <p class="text-xs text-black/30 tracking-wide font-bold uppercase">
            Tueste propio · Cada semana · Sin intermediarios
          </p>
          <div class="flex items-center gap-2 text-xs text-black/30 font-bold uppercase tracking-wide">
            <span class="w-2 h-2 bg-(--clr-accent)" />
            Temporada 2026
          </div>
        </div>
      </div>
    </section>
  )
}

<script>
  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.remove('opacity-0', 'translate-y-12', 'translate-y-4')
          entry.target.classList.add('opacity-100', 'translate-y-0')
          observer.unobserve(entry.target)
        }
      })
    },
    { threshold: 0.15 },
  )

  function redirect(element: HTMLElement) {
    if (!element) return
    const coffeeId = element.dataset.coffeeId
    if (!coffeeId) return

    const pathname = window.location.pathname

    window.location.href = `${pathname}/menu`
  }

  document.querySelectorAll('.coffee-card, .coffee-row').forEach((el) => observer.observe(el))
  document.querySelectorAll('.coffee-card, .coffee-row').forEach((el: Element) => {
    el.addEventListener('click', () => redirect(el as HTMLElement))
  })
</script>
