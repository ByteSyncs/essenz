---
const coffees = [
  {
    name: 'Etiopía Yirgacheffe',
    notes: 'Floral, Cítrico, Té negro',
    intensity: 'Suave',
    img: 'https://images.unsplash.com/photo-1559525839-b184a4d698c7?auto=format&fit=crop&q=80&w=600',
    span: 'col-span-1 md:col-span-2 row-span-2',
  },
  {
    name: 'Colombia Supremo',
    notes: 'Chocolate, Caramelo, Nuez',
    intensity: 'Medio',
    img: 'https://images.unsplash.com/photo-1497935586351-b67a49e012bf?auto=format&fit=crop&q=80&w=600',
    span: 'col-span-1',
  },
  {
    name: 'Sumatra Mandheling',
    notes: 'Terroso, Especiado, Cacao',
    intensity: 'Fuerte',
    img: 'https://images.unsplash.com/photo-1514432324607-a09d9b4aefdd?auto=format&fit=crop&q=80&w=600',
    span: 'col-span-1',
  },
  {
    name: 'Blend Espresso',
    notes: 'Avellana, Chocolate oscuro',
    intensity: 'Muy Fuerte',
    img: 'https://images.unsplash.com/photo-1509042239860-f550ce710b93?auto=format&fit=crop&q=80&w=600',
    span: 'col-span-1 md:col-span-2',
  },
]
---

<section id="variedades" class="py-20 bg-[#111111] text-[#F5EFE6]">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="mb-16">
      <h2 class="text-4xl md:text-5xl font-bold mb-4">Nuestros Granos</h2>
      <p class="text-gray-400 max-w-xl">
        Seleccionados de las mejores fincas del mundo y tostados en nuestra casa para resaltar su
        perfil único.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-4 auto-rows-[250px]">
      {
        coffees.map((coffee) => (
          <div
            class={`coffee-card opacity-0 translate-y-10 transition-all duration-700 ease-out group relative overflow-hidden ${coffee.span}`}
          >
            <img
              src={coffee.img}
              alt={coffee.name}
              class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105 opacity-80 group-hover:opacity-100"
            />
            <div class="absolute inset-0 bg-linear-to-t from-black/90 via-black/40 to-transparent flex flex-col justify-end p-6">
              <span class="text-[#2E4F3F] bg-[#F5EFE6] px-3 py-1 text-xs font-bold uppercase tracking-wider w-max mb-3">
                {coffee.intensity}
              </span>
              <h3 class="text-2xl font-bold text-white mb-1">{coffee.name}</h3>
              <p class="text-gray-300 text-sm font-['Inter']">{coffee.notes}</p>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>

<script>
  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.remove('opacity-0', 'translate-y-10')
          entry.target.classList.add('opacity-100', 'translate-y-0')
        }
      })
    },
    { threshold: 0.1 },
  )

  const cards = document.querySelectorAll('.coffee-card')
  cards.forEach((card) => observer.observe(card))
</script>
