---
import type { MenuItem } from '../types/menu'

interface Props {
  theme?: 'modern' | 'minimalist'
  dataProducts: MenuItem[]
  showImages?: boolean
}

const { theme = 'modern', dataProducts, showImages = true } = Astro.props
const isMin = theme === 'minimalist'
const products = dataProducts.slice(0, 6)
const menuUrl = `${Astro.url.pathname}/menu`

const formatPrice = (price: number) =>
  new Intl.NumberFormat('es-AR', {
    style: 'currency',
    currency: 'ARS',
    maximumFractionDigits: 0,
  }).format(price)
---

<section
  id="varieties"
  class:list={[
    'scroll-mt-24',
    isMin ? 'border-t border-black/10 bg-white py-20' : 'bg-(--clr-bg) py-20 text-(--clr-ink)',
  ]}
>
  <div class:list={['mx-auto max-w-7xl', isMin ? 'px-6 md:px-12' : 'px-5 sm:px-8']}>
    <div
      class:list={[
        'mb-10 flex flex-col gap-6 md:flex-row md:items-end md:justify-between',
        isMin && 'border-b border-black/10 pb-8',
      ]}
    >
      <div>
        <span
          class:list={[
            'mb-3 block text-[10px] font-bold uppercase tracking-[0.22em]',
            isMin ? 'text-black/40' : 'text-(--clr-green)',
          ]}
        >
          Carta digital · Actualizada por el negocio
        </span>
        <h2
          class:list={[
            'font-bold tracking-[-0.04em]',
            isMin
              ? 'text-[clamp(2.5rem,6vw,4rem)] leading-none text-black'
              : 'text-4xl text-(--clr-ink) sm:text-5xl',
          ]}
        >
          {isMin ? 'Una muestra de la carta.' : 'Algo rico para elegir.'}
        </h2>
      </div>
      <div class="max-w-md">
        <p
          class:list={['text-sm leading-relaxed', isMin ? 'text-black/55' : 'text-(--clr-ink)/65']}
        >
          Consultá productos, descripciones, precios y ofertas vigentes en la carta completa.
        </p>
        <a
          href={menuUrl}
          class:list={[
            'mt-4 inline-flex min-h-10 items-center gap-3 text-xs font-bold uppercase tracking-[0.14em] underline underline-offset-4',
            isMin ? 'text-black' : 'text-(--clr-ink)',
          ]}
        >
          Ver toda la carta <span aria-hidden="true">↗</span>
        </a>
      </div>
    </div>

    {
      products.length ? (
        isMin ? (
          <div class="divide-y divide-black/10 border-t border-black/10">
            {products.map((product, index) => (
              <a
                href={menuUrl}
                class="group grid grid-cols-[2rem_1fr_auto] items-center gap-4 py-5 no-underline sm:grid-cols-[3rem_1fr_auto_auto] sm:gap-6"
              >
                <span class="text-[10px] font-bold tracking-widest text-black/30">
                  0{index + 1}
                </span>
                <span class="min-w-0">
                  <span class="block truncate text-base font-bold text-black transition-colors group-hover:text-(--clr-accent) sm:text-lg">
                    {product.name}
                  </span>
                  {product.description && (
                    <span class="mt-1 block line-clamp-2 text-xs leading-relaxed text-black/50 sm:text-sm">
                      {product.description}
                    </span>
                  )}
                  {product.in_offer && product.offer_percent && (
                    <span class="mt-2 inline-block text-[9px] font-bold uppercase tracking-wider text-(--clr-accent)">
                      {product.offer_percent}% de descuento
                    </span>
                  )}
                </span>
                <span class="text-right text-sm font-bold text-black sm:text-base">
                  {formatPrice(
                    Number(product.price) *
                      (product.in_offer && product.offer_percent
                        ? 1 - product.offer_percent / 100
                        : 1),
                  )}
                </span>
                {showImages && product.image_url && (
                  <img
                    src={product.image_url}
                    alt=""
                    width="96"
                    height="96"
                    loading="lazy"
                    decoding="async"
                    class="hidden size-16 object-cover sm:block"
                  />
                )}
              </a>
            ))}
          </div>
        ) : (
          <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
            {products.map((product) => (
              <a
                href={menuUrl}
                class="group overflow-hidden rounded-2xl border border-(--clr-ink)/10 bg-(--clr-white) no-underline transition hover:-translate-y-1 hover:shadow-lg"
              >
                {showImages && product.image_url && (
                  <img
                    src={product.image_url}
                    alt=""
                    width="800"
                    height="600"
                    loading="lazy"
                    decoding="async"
                    class="aspect-4/3 w-full object-cover"
                  />
                )}
                <div class="p-5">
                  <div class="flex items-start justify-between gap-4">
                    <h3 class="text-lg font-bold text-(--clr-ink) transition-colors group-hover:text-(--clr-accent)">
                      {product.name}
                    </h3>
                    <span class="shrink-0 text-sm font-bold text-(--clr-ink)">
                      {formatPrice(
                        Number(product.price) *
                          (product.in_offer && product.offer_percent
                            ? 1 - product.offer_percent / 100
                            : 1),
                      )}
                    </span>
                  </div>
                  {product.description && (
                    <p class="mt-2 line-clamp-2 text-sm leading-relaxed text-(--clr-ink)/60">
                      {product.description}
                    </p>
                  )}
                  {product.in_offer && product.offer_percent && (
                    <span class="mt-3 inline-block rounded-full bg-(--clr-accent)/15 px-3 py-1 text-[10px] font-bold uppercase tracking-wider text-(--clr-ink)">
                      {product.offer_percent}% de descuento
                    </span>
                  )}
                </div>
              </a>
            ))}
          </div>
        )
      ) : (
        <div
          class:list={[
            'border-y py-8 text-sm',
            isMin ? 'border-black/10 text-black/55' : 'border-(--clr-ink)/10 text-(--clr-ink)/60',
          ]}
        >
          El negocio está preparando su carta digital. Mientras tanto, podés consultar su
          información y ubicación.
        </div>
      )
    }
  </div>
</section>
