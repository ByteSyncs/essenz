---
interface Props {
  theme?: 'modern' | 'minimalist'
  name?: string
}

const { theme = 'modern', name } = Astro.props
const year = new Date().getFullYear()
---

<footer
  class:list={[
    'border-t px-5 py-6 text-xs sm:px-8',
    theme === 'minimalist'
      ? 'border-white/10 bg-black text-white/55'
      : 'border-white/10 bg-(--clr-darker) text-white/55',
  ]}
>
  <div class="mx-auto flex max-w-7xl flex-col gap-2 sm:flex-row sm:items-center sm:justify-between">
    <span>© {year} {name}</span>
    <span class="uppercase tracking-[0.12em]">Carta digital con Essenz</span>
  </div>
</footer>
