---
import Layout from '../../layouts/Layout.astro'
import { collectTags, formatPrice, type CatalogCategory } from '../../libs/menu/catalog'

interface Props {
  slug: string
  name: string
  tagline?: string | null
  logoUrl?: string | null
  theme: 'modern' | 'minimalist'
  brandStyles?: string
  catalog: CatalogCategory[]
  pageTitle: string
  pageDescription: string
}

const { slug, name, tagline, logoUrl, theme, brandStyles, catalog, pageTitle, pageDescription } =
  Astro.props

const total = catalog.reduce((sum, category) => sum + category.items.length, 0)
const offerCount = catalog.reduce(
  (sum, category) => sum + category.items.filter((item) => item.offerPercent !== null).length,
  0,
)
const tags = collectTags(catalog)
const payload = JSON.stringify({ categories: catalog }).replace(/</g, '\\u003c')
const showLogo = typeof logoUrl === 'string' && /^https?:\/\//i.test(logoUrl)
let eagerImages = 2
---

<Layout title={pageTitle} description={pageDescription} theme={theme}>
  {brandStyles && <style set:html={`:root { ${brandStyles} }`} />}
  <noscript
    ><style>
      .mn-controls,
      .mn-meta {
        display: none;
      }
    </style></noscript
  >

  <div class="mn" data-theme={theme} data-total={total}>
    <a href="#carta" class="mn-skip">Ir a la carta</a>

    <div class="mn-wrap mn-top">
      <a href={`/${slug}`} class="mn-back">
        <svg
          width="16"
          height="16"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.75"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"><path d="m15 18-6-6 6-6"></path></svg
        >
        Volver al inicio
      </a>
    </div>

    <header class="mn-wrap mn-hero">
      {
        showLogo && (
          <img class="mn-logo" src={logoUrl} alt="" width="64" height="64" decoding="async" />
        )
      }
      <div class="mn-hero-text">
        <h1 class="mn-title">{name}</h1>
        <p class="mn-tagline">
          {tagline || 'Carta actualizada: productos, descripciones y precios.'}
        </p>
      </div>
    </header>

    {
      total === 0 ? (
        <main id="carta" class="mn-wrap mn-blank">
          <h2>La carta todavía no tiene productos</h2>
          <p>Volvé a pasar en un rato: el local la está preparando.</p>
        </main>
      ) : (
        <>
          <div class="mn-bar" data-bar>
            <div class="mn-wrap">
              <div class="mn-controls">
                <form class="mn-search" role="search" data-search-form>
                  <label for="mn-q" class="sr-only">
                    Buscar en la carta
                  </label>
                  <svg
                    class="mn-search-icon"
                    width="18"
                    height="18"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.75"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                  >
                    <>
                      <circle cx="11" cy="11" r="7" />
                      <path d="m21 21-4.35-4.35" />
                    </>
                  </svg>
                  <input
                    id="mn-q"
                    name="q"
                    type="search"
                    enterkeyhint="search"
                    autocomplete="off"
                    autocapitalize="off"
                    spellcheck="false"
                    maxlength="80"
                    placeholder="Buscar en la carta"
                  />
                  <button
                    type="button"
                    class="mn-clear"
                    data-clear
                    aria-label="Borrar búsqueda"
                    hidden
                  >
                    <svg
                      width="16"
                      height="16"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1.75"
                      stroke-linecap="round"
                      aria-hidden="true"
                    >
                      <path d="M18 6 6 18M6 6l12 12" />
                    </svg>
                  </button>
                </form>
                <button
                  type="button"
                  class="mn-filter-btn"
                  data-open-filters
                  aria-haspopup="dialog"
                >
                  <svg
                    width="18"
                    height="18"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.75"
                    stroke-linecap="round"
                    aria-hidden="true"
                  >
                    <path d="M21 4h-7M10 4H3M21 12h-9M8 12H3M21 20h-5M12 20H3M14 2v4M8 10v4M16 18v4" />
                  </svg>
                  <span>Filtros</span>
                  <span class="mn-filter-count" data-filter-count hidden />
                </button>
              </div>
              {catalog.length > 1 && (
                <nav class="mn-rail" aria-label="Categorías" data-rail>
                  {catalog.map((category, index) => (
                    <a
                      href={`#${category.anchor}`}
                      class="mn-chip"
                      data-chip={category.anchor}
                      aria-current={index === 0 ? 'true' : undefined}
                    >
                      {category.title}
                    </a>
                  ))}
                </nav>
              )}
            </div>
          </div>

          <main id="carta" class="mn-wrap">
            <div class="mn-meta">
              <p class="mn-status" role="status" aria-live="polite" data-status>
                {total} {total === 1 ? 'producto' : 'productos'}
              </p>
              {offerCount > 0 && (
                <button type="button" class="mn-link-btn" data-only-offers hidden>
                  Ver solo ofertas ({offerCount})
                </button>
              )}
              <ul class="mn-pills" data-pills hidden />
              <button type="button" class="mn-link-btn" data-reset-all hidden>
                Limpiar todo
              </button>
            </div>

            <div class="mn-empty" data-empty hidden>
              <h2 class="mn-empty-title">No encontramos coincidencias</h2>
              <p data-empty-text>Probá con otra palabra o quitá algún filtro.</p>
              <button type="button" class="mn-btn" data-reset-all>
                Ver toda la carta
              </button>
            </div>

            {catalog.map((category) => (
              <section
                class="mn-section"
                id={category.anchor}
                data-cat={category.anchor}
                aria-labelledby={`${category.anchor}-titulo`}
              >
                <div class="mn-section-head">
                  <h2 id={`${category.anchor}-titulo`}>{category.title}</h2>
                  <span class="mn-count" data-count aria-hidden="true">
                    {category.items.length}
                  </span>
                </div>
                <ul class="mn-list" data-list>
                  {category.items.map((item) => {
                    const eager = item.imageUrl !== null && eagerImages-- > 0
                    return (
                      <li class="mn-li" data-item={item.id}>
                        <button type="button" class="mn-item" data-open={item.id}>
                          <span class="mn-item-text">
                            <span class="mn-name">{item.name}</span>
                            {item.description && <span class="mn-desc">{item.description}</span>}
                            <span class="mn-price-row">
                              <span class="mn-price">{formatPrice(item.finalPrice)}</span>
                              {item.offerPercent !== null && (
                                <>
                                  <s class="mn-old">
                                    <span class="sr-only">Antes </span>
                                    {formatPrice(item.price)}
                                  </s>
                                  <span class="mn-badge" aria-hidden="true">
                                    -{item.offerPercent}%
                                  </span>
                                  <span class="sr-only">{item.offerPercent}% de descuento</span>
                                </>
                              )}
                            </span>
                          </span>
                          {item.imageUrl && (
                            <img
                              class="mn-thumb"
                              src={item.imageUrl}
                              alt=""
                              width="112"
                              height="112"
                              loading={eager ? 'eager' : 'lazy'}
                              decoding="async"
                            />
                          )}
                        </button>
                      </li>
                    )
                  })}
                </ul>
              </section>
            ))}
          </main>

          <dialog class="mn-dialog" id="mn-item-dialog" aria-labelledby="mn-item-title">
            <div class="mn-grab" data-grab>
              <span class="mn-grip" />
            </div>
            <button type="button" class="mn-close" data-close aria-label="Cerrar">
              <svg
                width="18"
                height="18"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.75"
                stroke-linecap="round"
                aria-hidden="true"
              >
                <path d="M18 6 6 18M6 6l12 12" />
              </svg>
            </button>
            <div class="mn-dialog-scroll" id="mn-item-body" />
          </dialog>

          <dialog class="mn-dialog" id="mn-filter-dialog" aria-labelledby="mn-filter-title">
            <div class="mn-grab" data-grab>
              <span class="mn-grip" />
            </div>
            <button type="button" class="mn-close" data-close aria-label="Cerrar">
              <svg
                width="18"
                height="18"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.75"
                stroke-linecap="round"
                aria-hidden="true"
              >
                <path d="M18 6 6 18M6 6l12 12" />
              </svg>
            </button>
            <div class="mn-dialog-scroll">
              <div class="mn-pad">
                <h2 id="mn-filter-title" class="mn-dialog-title">
                  Filtros
                </h2>

                <fieldset class="mn-fieldset">
                  <legend>Ordenar</legend>
                  <label class="mn-option">
                    <input type="radio" name="mn-sort" value="menu" checked />
                    <span>Orden de la carta</span>
                  </label>
                  <label class="mn-option">
                    <input type="radio" name="mn-sort" value="price-asc" />
                    <span>Precio: menor a mayor</span>
                  </label>
                  <label class="mn-option">
                    <input type="radio" name="mn-sort" value="price-desc" />
                    <span>Precio: mayor a menor</span>
                  </label>
                </fieldset>

                {offerCount > 0 && (
                  <fieldset class="mn-fieldset">
                    <legend>Mostrar</legend>
                    <label class="mn-option">
                      <input type="checkbox" data-offers-input />
                      <span>Solo ofertas</span>
                      <span class="mn-option-count">{offerCount}</span>
                    </label>
                  </fieldset>
                )}

                {tags.length > 0 && (
                  <fieldset class="mn-fieldset">
                    <legend>Etiquetas</legend>
                    {tags.map((tag) => (
                      <label class="mn-option">
                        <input type="checkbox" data-tag-input value={tag.key} />
                        <span>{tag.label}</span>
                        <span class="mn-option-count">{tag.count}</span>
                      </label>
                    ))}
                  </fieldset>
                )}
              </div>
            </div>
            <div class="mn-dialog-foot">
              <button type="button" class="mn-btn-ghost" data-reset-all>
                Limpiar
              </button>
              <button type="button" class="mn-btn" data-apply>
                Ver resultados
              </button>
            </div>
          </dialog>

          <script type="application/json" id="mn-data" set:html={payload} />
        </>
      )
    }
  </div>

  <script>
    import { initMenu } from './menu.client'
    initMenu()
  </script>
</Layout>

<style is:global>
  .mn {
    --mn-muted: color-mix(in srgb, var(--clr-ink) 68%, var(--clr-bg));
    --mn-line: color-mix(in srgb, var(--clr-ink) 12%, transparent);
    --mn-line-strong: color-mix(in srgb, var(--clr-ink) 32%, transparent);
    --mn-tint: color-mix(in srgb, var(--clr-ink) 6%, transparent);
    --mn-surface: var(--clr-white);
    --mn-dialog-bg: var(--clr-white);
    --mn-ease: cubic-bezier(0.23, 1, 0.32, 1);
    --mn-drawer: cubic-bezier(0.32, 0.72, 0, 1);
    --mn-radius: 0;
    --mn-radius-pill: 0;
    --mn-radius-card: 0;
    --mn-radius-img: 0;
    --mn-radius-sheet: 0;
    --mn-radius-modal: 0;
    --mn-radius-tag: 0;
    min-height: 100dvh;
    background: var(--clr-bg);
    color: var(--clr-ink);
    font-family: var(--font-body);
    -webkit-text-size-adjust: 100%;
  }
  .mn[data-theme='modern'] {
    --mn-dialog-bg: var(--clr-bg);
    --mn-radius: 0.75rem;
    --mn-radius-pill: 999px;
    --mn-radius-card: 1.25rem;
    --mn-radius-img: 0.75rem;
    --mn-radius-sheet: 1.5rem;
    --mn-radius-modal: 1.5rem;
    --mn-radius-tag: 0.375rem;
  }
  .mn [hidden] {
    display: none !important;
  }
  .mn ::selection {
    background: var(--clr-ink);
    color: var(--clr-bg);
  }
  .mn :focus-visible {
    outline: 2px solid var(--clr-ink);
    outline-offset: 2px;
  }
  .mn-skip {
    position: absolute;
    left: 0.5rem;
    top: -4rem;
    z-index: 60;
    padding: 0.75rem 1rem;
    background: var(--clr-ink);
    color: var(--clr-bg);
    text-decoration: none;
  }
  .mn-skip:focus {
    top: 0.5rem;
  }
  html:has(.mn-dialog[open]) {
    overflow: hidden;
  }
  html {
    scroll-padding-top: calc(var(--mn-bar-h, 7rem) + 0.5rem);
  }

  .mn-wrap {
    width: 100%;
    max-width: 72rem;
    margin-inline: auto;
    padding-inline: 1rem;
  }
  @media (min-width: 640px) {
    .mn-wrap {
      padding-inline: 1.5rem;
    }
  }
  @media (min-width: 1024px) {
    .mn-wrap {
      padding-inline: 2rem;
    }
  }

  .mn-back {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    min-height: 44px;
    font: 500 0.875rem var(--font-ui);
    color: var(--mn-muted);
    text-decoration: none;
    transition: color 150ms ease;
  }
  .mn-back:hover {
    color: var(--clr-ink);
  }
  .mn-hero {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding-block: 0.25rem 1.5rem;
  }
  .mn-logo {
    flex: none;
    width: 3.5rem;
    height: 3.5rem;
    object-fit: cover;
    border-radius: var(--mn-radius-img);
    background: var(--mn-tint);
  }
  .mn-hero-text {
    min-width: 0;
  }
  .mn-title {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(1.75rem, 6vw, 3rem);
    font-weight: 700;
    line-height: 1.05;
    letter-spacing: -0.03em;
    text-wrap: balance;
    overflow-wrap: anywhere;
  }
  .mn[data-theme='modern'] .mn-title {
    font-weight: 600;
    letter-spacing: -0.02em;
  }
  .mn-tagline {
    margin: 0.5rem 0 0;
    max-width: 60ch;
    font-size: 0.9375rem;
    line-height: 1.5;
    color: var(--mn-muted);
    overflow-wrap: anywhere;
  }
  .mn-blank {
    padding-block: 3rem 5rem;
  }
  .mn-blank h2 {
    margin: 0;
    font-size: 1.375rem;
  }
  .mn-blank p {
    margin: 0.5rem 0 0;
    color: var(--mn-muted);
  }

  .mn-bar {
    position: sticky;
    top: 0;
    z-index: 30;
    background: color-mix(in srgb, var(--clr-bg) 92%, transparent);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-block: 1px solid var(--mn-line);
  }
  @media (prefers-reduced-transparency: reduce) {
    .mn-bar {
      background: var(--clr-bg);
      backdrop-filter: none;
      -webkit-backdrop-filter: none;
    }
  }
  .mn-controls {
    display: flex;
    gap: 0.5rem;
    padding-block: 0.625rem;
  }
  .mn-search {
    position: relative;
    flex: 1 1 0;
    min-width: 0;
    max-width: 32rem;
    margin: 0;
  }
  .mn-search input {
    width: 100%;
    height: 44px;
    padding: 0 2.75rem;
    font: inherit;
    font-size: 1rem;
    color: var(--clr-ink);
    background: var(--mn-surface);
    border: 1px solid var(--mn-line-strong);
    border-radius: var(--mn-radius);
    appearance: none;
    transition: border-color 150ms ease;
  }
  .mn-search input::placeholder {
    color: var(--mn-muted);
    opacity: 1;
  }
  .mn-search input::-webkit-search-cancel-button {
    display: none;
  }
  .mn-search input:hover {
    border-color: var(--clr-ink);
  }
  .mn-search input:focus-visible {
    outline-offset: 0;
    border-color: var(--clr-ink);
  }
  .mn-search-icon {
    position: absolute;
    left: 0.875rem;
    top: 50%;
    translate: 0 -50%;
    color: var(--mn-muted);
    pointer-events: none;
  }
  .mn-clear {
    position: absolute;
    right: 0;
    top: 0;
    width: 44px;
    height: 44px;
    display: grid;
    place-items: center;
    color: var(--mn-muted);
    background: none;
    border: 0;
    cursor: pointer;
  }
  .mn-clear:hover {
    color: var(--clr-ink);
  }
  .mn-filter-btn {
    flex: none;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    height: 44px;
    padding-inline: 0.875rem;
    font: 500 0.875rem var(--font-ui);
    color: var(--clr-ink);
    background: var(--mn-surface);
    border: 1px solid var(--mn-line-strong);
    border-radius: var(--mn-radius);
    cursor: pointer;
    transition:
      border-color 150ms ease,
      transform 120ms var(--mn-ease);
  }
  .mn-filter-btn:hover {
    border-color: var(--clr-ink);
  }
  .mn-filter-btn:active {
    transform: scale(0.97);
  }
  .mn-filter-count {
    min-width: 1.25rem;
    height: 1.25rem;
    padding-inline: 0.3rem;
    display: inline-grid;
    place-items: center;
    font-size: 0.75rem;
    font-weight: 600;
    background: var(--clr-ink);
    color: var(--clr-bg);
    border-radius: var(--mn-radius-pill);
  }
  .mn-rail {
    position: relative;
    display: flex;
    gap: 0.5rem;
    margin-inline: -1rem;
    padding: 0 1rem 0.625rem;
    overflow-x: auto;
    scroll-padding-inline: 1rem;
    scrollbar-width: none;
    overscroll-behavior-x: contain;
  }
  .mn-rail::-webkit-scrollbar {
    display: none;
  }
  @media (min-width: 640px) {
    .mn-rail {
      margin-inline: -1.5rem;
      padding-inline: 1.5rem;
      scroll-padding-inline: 1.5rem;
    }
  }
  @media (min-width: 1024px) {
    .mn-rail {
      margin-inline: -2rem;
      padding-inline: 2rem;
      scroll-padding-inline: 2rem;
    }
  }
  .mn-chip {
    flex: none;
    display: inline-flex;
    align-items: center;
    height: 40px;
    padding-inline: 1rem;
    font: 500 0.875rem var(--font-ui);
    color: var(--clr-ink);
    text-decoration: none;
    white-space: nowrap;
    border: 1px solid var(--mn-line-strong);
    border-radius: var(--mn-radius-pill);
    transition:
      background-color 150ms ease,
      color 150ms ease,
      border-color 150ms ease,
      transform 120ms var(--mn-ease);
  }
  .mn-chip:active {
    transform: scale(0.97);
  }
  .mn-chip[aria-current='true'] {
    background: var(--clr-ink);
    color: var(--clr-bg);
    border-color: var(--clr-ink);
  }
  @media (hover: hover) and (pointer: fine) {
    .mn-chip:not([aria-current='true']):hover {
      border-color: var(--clr-ink);
    }
  }

  .mn-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.25rem 0.875rem;
    min-height: 2.5rem;
    padding-top: 1rem;
    font-size: 0.875rem;
    color: var(--mn-muted);
  }
  .mn-status {
    margin: 0;
    font-variant-numeric: tabular-nums;
  }
  .mn-pills {
    display: contents;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .mn-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    height: 32px;
    padding-inline: 0.75rem 0.5rem;
    font: 500 0.8125rem var(--font-ui);
    color: var(--clr-ink);
    background: none;
    border: 1px solid var(--clr-ink);
    border-radius: var(--mn-radius-pill);
    cursor: pointer;
  }
  .mn-link-btn {
    min-height: 32px;
    padding: 0;
    font: inherit;
    font-weight: 500;
    color: var(--clr-ink);
    background: none;
    border: 0;
    text-decoration: underline;
    text-underline-offset: 3px;
    cursor: pointer;
  }

  .mn-empty {
    padding-block: 3rem 4rem;
    max-width: 28rem;
  }
  .mn-empty-title {
    margin: 0;
    font-size: 1.375rem;
    overflow-wrap: anywhere;
  }
  .mn-empty p {
    margin: 0.5rem 0 1.25rem;
    color: var(--mn-muted);
    overflow-wrap: anywhere;
  }

  .mn-section {
    padding-top: 2rem;
    scroll-margin-top: calc(var(--mn-bar-h, 7rem) + 0.5rem);
  }
  .mn-section:last-of-type {
    padding-bottom: 5rem;
  }
  .mn-section-head {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
    margin-bottom: 0.25rem;
  }
  .mn-section-head h2 {
    margin: 0;
    font-size: 1.375rem;
    line-height: 1.2;
    letter-spacing: -0.02em;
    text-wrap: balance;
    overflow-wrap: anywhere;
  }
  .mn[data-theme='modern'] .mn-section-head h2 {
    font-size: 1.75rem;
    font-weight: 600;
  }
  .mn-count {
    flex: none;
    font-size: 0.8125rem;
    color: var(--mn-muted);
    font-variant-numeric: tabular-nums;
  }
  .mn-list {
    display: grid;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .mn-li {
    border-bottom: 1px solid var(--mn-line);
  }
  .mn-item {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    column-gap: 1rem;
    align-items: start;
    width: 100%;
    padding: 1rem 0;
    text-align: left;
    font: inherit;
    color: inherit;
    background: none;
    border: 0;
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
    transition: transform 120ms var(--mn-ease);
  }
  .mn-item:active {
    transform: scale(0.985);
  }
  .mn-item-text {
    grid-column: 1;
    grid-row: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }
  .mn-name {
