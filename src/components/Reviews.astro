---
import type { Review } from '../types/reviewClients'
import { DATA } from '../data/reviewClients'

const { theme } = Astro.props
const isMin = theme === 'minimalist'
const clients: Review[] = DATA
---

{
  !isMin ? (
    <section class="py-20 bg-(--clr-bg)">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
        <h2 class="text-3xl md:text-4xl font-bold mb-12 text-(--clr-ink)">
          Lo que dicen quienes nos eligen
        </h2>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
          {clients.map((review) => (
            <div
              class="p-8 bg-(--clr-white) shadow-sm border border-(--clr-ink)/5 text-left flex flex-col h-full"
              style="border-radius: var(--radius-card);"
            >
              <div class="flex text-(--clr-accent) mb-6">★★★★★</div>
              <p class="text-gray-600 italic mb-8 grow leading-relaxed">"{review.text}"</p>
              <div class="flex items-center gap-4 border-t border-gray-100 pt-6">
                <div>
                  <h4 class="font-semibold text-(--clr-dark) text-base">{review.name}</h4>
                  <p class="text-sm text-gray-500">{review.role}</p>
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>
  ) : (
    <section class="py-24 bg-(--clr-bg) border-t border-black/8">
      <div class="max-w-7xl mx-auto px-6 md:px-12">
        <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-6 mb-14 pb-10 border-b border-black/10">
          <div>
            <span class="block text-[10px] font-bold tracking-[0.35em] uppercase text-black/30 mb-3">
              — Testimonios
            </span>
            <h2 class="text-[clamp(2rem,4vw,3.5rem)] font-bold text-black tracking-[-0.03em] leading-none">
              Lo dicen
              <br />
              ellos
            </h2>
          </div>
          <p class="text-sm text-black/40 max-w-xs leading-relaxed">
            Personas reales. Opiniones honestas. Café de verdad.
          </p>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-0 border-l border-black/8">
          {clients.map((review, i) => (
            <div
              class="review-item group border-r border-b border-black/8 p-8 lg:p-10 flex flex-col gap-6 opacity-0 translate-y-4 transition-all duration-500 ease-out"
              style={`transition-delay: ${i * 100}ms`}
            >
              <div class="flex items-center justify-between">
                <span class="text-[10px] font-bold tracking-[0.25em] text-black/20 tabular-nums">
                  0{i + 1}
                </span>
                <div class="flex gap-0.5" aria-label="5 estrellas">
                  {Array(5)
                    .fill(null)
                    .map(() => (
                      <svg
                        width="10"
                        height="10"
                        viewBox="0 0 10 10"
                        fill="var(--clr-accent)"
                        aria-hidden="true"
                      >
                        <polygon points="5,1 6.2,3.8 9,3.8 6.8,5.7 7.6,8.5 5,6.8 2.4,8.5 3.2,5.7 1,3.8 3.8,3.8" />
                      </svg>
                    ))}
                </div>
              </div>
              <p class="text-base leading-relaxed text-black/65 grow">"{review.text}"</p>
              <div class="border-t border-black/8 pt-5 flex items-center justify-between">
                <div>
                  <span class="block text-sm font-bold text-black tracking-[-0.01em]">
                    {review.name}
                  </span>
                  <span class="block text-xs text-black/40 mt-0.5">{review.role}</span>
                </div>
                <span class="w-2 h-2 bg-(--clr-accent) opacity-0 group-hover:opacity-100 transition-opacity duration-200" />
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>
  )
}
