---
import Layout from '../../../layouts/Layout.astro'
import DemoCta from '../DemoContact.astro'
import { ESSENZ_URL } from '../../../constants/site'

const supabase = Astro.locals.supabase
const { data: tenant, error: organizationError } = await supabase
  .from('organizations')
  .select('id, name, tagline, logo_url')
  .eq('slug', 'demo-modern')
  .maybeSingle()

if (organizationError) {
  console.error('[demo-modern] organization error:', organizationError)
  throw new Error('Could not load the modern demo organization.', { cause: organizationError })
}

if (!tenant) return Astro.redirect('/404')

const { data: categories, error: categoriesError } = await supabase
  .from('categories')
  .select(
    `
    id,
    title,
    display_order,
    products (
      id,
      name,
      description,
      price,
      image_url,
      in_offer,
      offer_percent,
      is_active,
      display_order
    )
  `,
  )
  .eq('organization_id', tenant.id)
  .eq('products.is_active', true)
  .order('display_order', { ascending: true })
  .order('display_order', { referencedTable: 'products', ascending: true })

if (categoriesError) {
  console.error('[demo-modern] products error:', categoriesError)
  throw new Error('Could not load the modern demo menu.', { cause: categoriesError })
}

const groups = (categories ?? [])
  .map((category) => ({
    id: category.id,
    title: category.title,
    items: [...(category.products ?? [])]
      .filter((product) => product.is_active)
      .sort((a, b) => (a.display_order ?? 0) - (b.display_order ?? 0)),
  }))
  .filter((group) => group.items.length > 0)

const products = groups.flatMap((group) =>
  group.items.map((product) => ({ ...product, category: group.title })),
)
const ranked = [...products].sort(
  (a, b) => Number(Boolean(b.image_url)) - Number(Boolean(a.image_url)),
)
const featuredProduct = ranked.find((product) => product.image_url)
const others = ranked.filter((product) => product.id !== featuredProduct?.id)
const previewProducts = (others.length >= 3 ? others : ranked).slice(0, 3)
const featuredImage = featuredProduct?.image_url ?? tenant.logo_url ?? undefined
const featuredIsLogo = !featuredProduct?.image_url && Boolean(tenant.logo_url)

const getFinalPrice = (product: {
  price: number | string
  in_offer?: boolean | null
  offer_percent?: number | null
}) => {
  const price = Number(product.price)
  return product.in_offer && product.offer_percent
    ? price * (1 - product.offer_percent / 100)
    : price
}
const formatPrice = (price: number) =>
  new Intl.NumberFormat('es-AR', {
    style: 'currency',
    currency: 'ARS',
    maximumFractionDigits: 0,
  }).format(price)
---

<Layout
  title={`${tenant.name} | Sitio oficial`}
  description={tenant.tagline ??
    `Conocé ${tenant.name}, consultá su carta actualizada y encontrá la información para visitar el local.`}
  theme="modern"
  preloadImage={featuredImage}
>
  <main class="bg-[#f5efe6] text-[#2c1e16]">
    <div
      class="flex flex-wrap items-center justify-center gap-x-3 gap-y-1 bg-[#2c1e16] px-5 py-2.5 text-center text-[11px] font-medium text-white/75"
    >
      <span>Demo de Essenz con datos de ejemplo.</span>
      <a
        href={ESSENZ_URL}
        class="press font-semibold text-white underline underline-offset-4 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#d7b98e]"
      >
        Crear mi sitio ↗
      </a>
    </div>

    <header class="glass-bar sticky top-0 z-30 border-b border-[#2c1e16]/10 px-5 py-3 sm:px-10">
      <nav
        aria-label={`Navegación de ${tenant.name}`}
        class="mx-auto flex max-w-7xl items-center justify-between gap-4"
      >
        <a
          href="/demo-modern"
          class="press flex min-h-11 items-center gap-3 font-(family-name:--font-display) text-xl font-semibold sm:text-2xl"
        >
          {
            tenant.logo_url && (
              <img
                src={tenant.logo_url}
                alt=""
                width="36"
                height="36"
                decoding="async"
                class="size-9 rounded-full object-cover"
              />
            )
          }
          {tenant.name}
        </a>
        <div class="flex items-center gap-2 sm:gap-3">
          <a
            href="/demo-modern/menu"
            class="press inline-flex min-h-11 items-center rounded-full px-4 text-sm font-semibold hover:bg-[#2c1e16]/8 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#8b5a2b]"
          >
            La carta
          </a>
          <a
            href={ESSENZ_URL}
            class="press inline-flex min-h-11 items-center rounded-full bg-[#2c1e16] px-5 text-sm font-semibold text-white hover:bg-[#65422e] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#8b5a2b]"
          >
            Crear el mío
          </a>
        </div>
      </nav>
    </header>

    <section class="px-5 pb-10 pt-10 sm:px-10 sm:pb-14 sm:pt-16">
      <div class="mx-auto grid max-w-7xl items-center gap-10 lg:grid-cols-[0.9fr_1.1fr] lg:gap-16">
        <div>
          <p
            class="rise mb-5 text-xs font-bold uppercase tracking-[0.18em] text-[#8b5a2b]"
            style="--i:0"
          >
            {tenant.tagline ?? 'La carta de hoy'}
          </p>
          <h1
            class="rise max-w-2xl text-balance font-(family-name:--font-display) text-5xl leading-[1.02] font-semibold tracking-[-0.03em] sm:text-7xl xl:text-8xl"
            style="--i:1"
          >
            {tenant.name}<span class="font-normal italic text-[#8b5a2b]">.</span>
          </h1>
          <p
            class="rise mt-6 max-w-md text-base leading-relaxed text-[#2c1e16]/70 sm:text-lg"
            style="--i:2"
          >
            Mirá la carta, elegí qué pedir y llegá sabiendo lo que querés.
          </p>
          <div class="rise mt-8 flex flex-wrap gap-3" style="--i:3">
            <a
              href="/demo-modern/menu"
              class="press inline-flex min-h-12 items-center rounded-full bg-[#2c1e16] px-7 text-sm font-semibold text-white hover:bg-[#65422e] focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[#8b5a2b]"
            >
              Ver la carta completa
            </a>
            <a
              href="#selection"
              class="press inline-flex min-h-12 items-center rounded-full border border-[#2c1e16]/25 px-7 text-sm font-semibold hover:border-[#2c1e16] focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[#8b5a2b]"
            >
              Ver destacados
            </a>
          </div>
        </div>

        <figure
          class="rise relative min-h-96 overflow-hidden rounded-4xl bg-[#e3d4bf] sm:min-h-128"
          style="--i:2"
        >
          {
            featuredImage && (
              <img
                src={featuredImage}
                alt={featuredProduct?.name ?? tenant.name}
                width="1600"
                height="1200"
                loading="eager"
                fetchpriority="high"
                decoding="async"
                class:list={[
                  'modern-feature-image absolute inset-0 size-full',
                  featuredIsLogo ? 'object-contain p-16' : 'object-cover',
                ]}
              />
            )
          }
          {
            featuredProduct && (
              <div class="glass-chip absolute right-4 bottom-4 left-4 flex items-center justify-between gap-4 rounded-2xl px-4 py-3 sm:right-auto sm:min-w-80">
                <div class="min-w-0">
                  <p class="text-[10px] font-bold uppercase tracking-[0.16em] text-[#8b5a2b]">
                    Destacado
                  </p>
                  <p class="mt-1 truncate font-(family-name:--font-display) text-base font-semibold">
                    {featuredProduct.name}
                  </p>
                </div>
                <p class="text-sm font-semibold tabular-nums">
                  {formatPrice(getFinalPrice(featuredProduct))}
                </p>
              </div>
            )
          }
          <figcaption class="sr-only">
            {featuredProduct?.name ?? `Imagen de ${tenant.name}`}
          </figcaption>
        </figure>
      </div>
    </section>

    {
      groups.length > 0 && (
        <nav aria-label="Categorías de la carta" class="px-5 pb-14 sm:px-10 sm:pb-20">
          <ul class="mx-auto flex max-w-7xl snap-x gap-2 overflow-x-auto pb-1 [scrollbar-width:none]">
            {groups.map((group) => (
              <li class="shrink-0 snap-start">
                <a
                  href={`/demo-modern/menu#category-${group.id}`}
                  class="press inline-flex min-h-11 items-center gap-2 rounded-full border border-[#2c1e16]/20 px-5 text-sm font-semibold hover:border-[#2c1e16] hover:bg-white/60 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#8b5a2b]"
                >
                  {group.title}
                  <span class="text-xs font-medium tabular-nums text-[#2c1e16]/50">
                    {group.items.length}
                  </span>
                </a>
              </li>
            ))}
          </ul>
        </nav>
      )
    }

    <section id="selection" class="scroll-mt-20 bg-white/70 px-5 py-16 sm:px-10 sm:py-24">
      <div
        class="mx-auto mb-10 flex max-w-7xl flex-col gap-5 sm:flex-row sm:items-end sm:justify-between"
      >
        <div>
          <p class="mb-3 text-xs font-bold uppercase tracking-[0.18em] text-[#8b5a2b]">
            Una mirada a la carta
          </p>
          <h2
            class="max-w-2xl text-balance font-(family-name:--font-display) text-4xl leading-[1.05] font-semibold tracking-[-0.02em] sm:text-5xl"
          >
            Tres para empezar a elegir.
          </h2>
        </div>
        <a
          href="/demo-modern/menu"
          class="press inline-flex min-h-11 w-fit items-center gap-3 border-b border-[#2c1e16]/35 pb-1 text-sm font-semibold focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[#8b5a2b]"
        >
          Ver la carta completa <span aria-hidden="true">↗</span>
        </a>
      </div>

      {
        previewProducts.length ? (
          <ul class="mx-auto grid max-w-7xl gap-x-6 gap-y-10 sm:grid-cols-2 lg:grid-cols-3">
            {previewProducts.map((product, index) => {
              const finalPrice = getFinalPrice(product)
              const hasOffer = Boolean(product.in_offer && product.offer_percent)

              return (
                <li class="rise min-w-0" style={`--i:${index}`}>
                  <a
                    href="/demo-modern/menu"
                    class="modern-product press group block focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[#8b5a2b]"
                    aria-label={`Ver ${product.name} en la carta`}
                  >
                    <div class="aspect-4/3 w-full overflow-hidden rounded-3xl bg-[#e8ddce]">
                      {product.image_url && (
                        <img
                          src={product.image_url}
                          alt={product.name}
                          width="800"
                          height="600"
                          loading="lazy"
                          decoding="async"
                          class="modern-product-image size-full object-cover"
                        />
                      )}
                    </div>
                    <div class="flex items-start justify-between gap-4 border-b border-[#2c1e16]/20 py-4">
                      <div class="min-w-0">
                        <p class="text-[10px] font-bold uppercase tracking-[0.16em] text-[#8b5a2b]">
                          {product.category}
                        </p>
                        <h3 class="mt-2 font-(family-name:--font-display) text-xl font-semibold">
                          {product.name}
                        </h3>
                        {product.description && (
                          <p class="mt-2 line-clamp-2 text-sm leading-relaxed text-[#2c1e16]/65">
                            {product.description}
                          </p>
                        )}
                      </div>
                      <div class="shrink-0 text-right">
                        <p class="text-base font-semibold tabular-nums">
                          {formatPrice(finalPrice)}
                        </p>
                        {hasOffer && (
                          <p class="mt-1 text-xs tabular-nums text-[#2c1e16]/45 line-through">
                            {formatPrice(Number(product.price))}
                          </p>
                        )}
                      </div>
                    </div>
                  </a>
                </li>
              )
            })}
          </ul>
        ) : (
          <p class="mx-auto max-w-7xl text-sm text-[#2c1e16]/60">
            El negocio todavía no publicó productos en su carta.
          </p>
        )
      }
    </section>

    <DemoCta theme="modern" name={tenant.name} />

    <footer
      class="flex flex-col gap-3 bg-[#2c1e16] px-5 py-7 text-xs text-white/55 sm:flex-row sm:items-center sm:justify-between sm:px-10"
    >
      <span>{tenant.name} · Demo de Essenz.</span>
      <nav aria-label={`Más información de ${tenant.name}`} class="flex flex-wrap gap-x-5 gap-y-2">
        <a href="/demo-modern/menu" class="font-semibold text-white underline underline-offset-4"
          >La carta</a
        >
        <a href={ESSENZ_URL} class="font-semibold text-white underline underline-offset-4"
          >Conocer Essenz</a
        >
      </nav>
    </footer>
  </main>

  <style>
    :global(html) {
      -webkit-tap-highlight-color: transparent;
      -webkit-text-size-adjust: 100%;
    }

    a {
      touch-action: manipulation;
    }

    .press {
      transition:
        transform 160ms cubic-bezier(0.23, 1, 0.32, 1),
        background-color 160ms ease,
        border-color 160ms ease;
    }

    .press:active {
      transform: scale(0.97);
    }

    .glass-bar {
      background: rgba(245, 239, 230, 0.74);
      -webkit-backdrop-filter: blur(18px) saturate(180%);
      backdrop-filter: blur(18px) saturate(180%);
    }

    .glass-chip {
      background: rgba(245, 239, 230, 0.82);
      -webkit-backdrop-filter: blur(14px) saturate(160%);
      backdrop-filter: blur(14px) saturate(160%);
      border: 1px solid rgba(255, 255, 255, 0.45);
    }

    @media (prefers-reduced-transparency: reduce) {
      .glass-bar,
      .glass-chip {
        background: #f5efe6;
        -webkit-backdrop-filter: none;
        backdrop-filter: none;
      }
    }

    @media (prefers-reduced-motion: no-preference) {
      :global(html) {
        scroll-behavior: smooth;
      }

      .rise {
        opacity: 1;
        transform: translateY(0);
        transition:
          opacity 420ms cubic-bezier(0.23, 1, 0.32, 1),
          transform 420ms cubic-bezier(0.23, 1, 0.32, 1);
        transition-delay: calc(min(var(--i, 0), 8) * 50ms);
      }

      @starting-style {
        .rise {
          opacity: 0;
          transform: translateY(10px);
        }
      }

      .modern-feature-image {
        clip-path: inset(0);
        transition: clip-path 550ms cubic-bezier(0.23, 1, 0.32, 1);
      }

      @starting-style {
        .modern-feature-image {
          clip-path: inset(0 0 0 100%);
        }
      }
    }

    @media (hover: hover) and (pointer: fine) {
      .modern-product-image {
        transition: transform 220ms cubic-bezier(0.23, 1, 0.32, 1);
      }

      .modern-product:hover .modern-product-image {
        transform: scale(1.03);
      }
    }
  </style>
</Layout>
