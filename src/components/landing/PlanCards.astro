---
import { PLANS } from '../../constants/suscriptions'

const plans = [
  {
    ...PLANS.basic,
    branchLabel: '1 sucursal',
    productLimit: '100 productos de menú',
    inventoryLabel: 'Inventario básico',
    description: 'Todo lo necesario para organizar tu negocio gastronómico.',
    featured: false,
  },
  {
    ...PLANS.business,
    branchLabel: 'Hasta 5 sucursales',
    productLimit: '1.000 productos por sucursal',
    inventoryLabel: 'Mayor capacidad de inventario',
    description: 'Más capacidad para administrar y hacer crecer tu negocio.',
    featured: true,
  },
]

const sharedFeatures = [
  'Sitio web y menú digital',
  'Código QR para tus clientes',
  'Pedidos y comandas',
  'Inventario y control de stock',
  'Gastos y estadísticas',
]
---

<section id="plans" class="bg-[#f8f6f2] px-5 py-16 sm:px-8 sm:py-24" aria-labelledby="plans-title">
  <div class="mx-auto max-w-6xl">
    <header class="mx-auto max-w-2xl text-center">
      <span class="text-xs font-bold tracking-[0.18em] text-emerald-800 uppercase">
        Planes de Essenz
      </span>

      <h2
        id="plans-title"
        class="mt-4 text-3xl leading-tight font-semibold tracking-tight text-(--clr-ink) sm:text-4xl"
      >
        Todo tu negocio, mejor organizado.
      </h2>

      <p class="mt-4 text-base leading-relaxed text-stone-600 sm:text-lg">
        Todas las herramientas que necesitás para gestionar tu negocio gastronómico. Elegí el plan
        según la capacidad que necesitás.
      </p>
    </header>

    <div class="mt-10 grid items-stretch gap-5 md:grid-cols-2 md:gap-6">
      {
        plans.map((plan) => (
          <article
            class:list={[
              'relative flex min-w-0 flex-col rounded-3xl border bg-white p-6 shadow-sm sm:p-8',
              plan.featured
                ? 'border-emerald-800/40 ring-1 ring-emerald-800/10'
                : 'border-stone-200',
            ]}
          >
            {plan.featured && (
              <span class="absolute -top-3 right-6 rounded-full bg-emerald-800 px-3 py-1.5 text-xs font-semibold text-white">
                Más capacidad
              </span>
            )}

            <div class="flex items-center justify-between gap-3">
              <span class="text-sm font-bold tracking-[0.16em] text-emerald-800 uppercase">
                {plan.name.replace('Plan ', '')}
              </span>
            </div>

            <p class="mt-3 text-sm leading-relaxed text-stone-600">{plan.description}</p>

            <div class="mt-6">
              <p class="text-sm font-medium text-stone-500">Precio mensual</p>
              <p class="mt-1 flex flex-wrap items-baseline gap-x-2">
                <span class="text-4xl font-bold tracking-tight text-emerald-800">
                  ${plan.price?.toLocaleString('es-AR')}
                </span>
                <span class="text-sm text-stone-500">ARS / mes</span>
              </p>
            </div>

            <div class="my-6 h-px bg-stone-200" />

            <div>
              <h3 class="text-sm font-semibold text-(--clr-ink)">Capacidad de tu plan</h3>

              <ul class="mt-4 space-y-3">
                {[plan.branchLabel, plan.productLimit, plan.inventoryLabel].map((item) => (
                  <li class="flex items-start gap-2.5 text-sm text-stone-600">
                    <span class="mt-0.5 font-bold text-emerald-800" aria-hidden="true">
                      ✓
                    </span>
                    <span>{item}</span>
                  </li>
                ))}
              </ul>
            </div>

            <div class="mt-6 rounded-2xl bg-[#f8f6f2] p-4">
              <p class="text-sm font-semibold text-(--clr-ink)">Todas las herramientas incluidas</p>

              <ul class="mt-3 space-y-2">
                {sharedFeatures.map((feature) => (
                  <li class="flex items-start gap-2 text-sm leading-relaxed text-stone-600">
                    <span class="font-bold text-emerald-800" aria-hidden="true">
                      ✓
                    </span>
                    <span>{feature}</span>
                  </li>
                ))}
              </ul>
            </div>

            <div class="mt-auto pt-6">
              <a
                href={`/auth/sign-up?plan=${plan.id}`}
                class:list={[
                  'inline-flex min-h-12 w-full items-center justify-center gap-2 rounded-full px-5 py-3 text-center text-sm font-semibold transition focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-emerald-800',
                  plan.featured
                    ? 'bg-emerald-800 text-white hover:bg-emerald-900'
                    : 'bg-(--clr-ink) text-white hover:bg-emerald-800',
                ]}
              >
                Elegir {plan.name.replace('Plan ', '')}
                <span aria-hidden="true">→</span>
              </a>
            </div>
          </article>
        ))
      }
    </div>

    <div class="mt-8 text-center">
      <a
        href="/plans"
        class="inline-flex min-h-11 items-center justify-center gap-2 rounded-full border border-(--clr-ink)/20 px-6 py-3 text-sm font-semibold text-(--clr-ink) transition hover:border-emerald-800 hover:bg-white focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-emerald-800"
      >
        Comparar planes en detalle
        <span aria-hidden="true">→</span>
      </a>
    </div>
  </div>
</section>
