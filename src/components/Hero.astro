---
interface Props {
  theme?: 'modern' | 'minimalist'
}

const { theme = 'modern' } = Astro.props
const isMin = theme === 'minimalist'

const menuUrl = Astro.url.pathname + '/menu'
---

<section
  id="home"
  class:list={[
    'relative w-full flex items-center overflow-hidden bg-(--clr-bg)',
    isMin ? 'min-h-screen' : 'min-h-dvh',
  ]}
>
  {!isMin && <canvas id="hero-canvas" class="absolute inset-0 w-full h-full z-0" />}

  {
    !isMin && (
      <div class="absolute inset-0 z-1 pointer-events-none bg-[radial-gradient(ellipse_70%_80%_at_60%_50%,transparent_30%,color-mix(in_srgb,--clr-bg_60%,transparent)_100%)]" />
    )
  }

  {
    !isMin && (
      <div
        id="cup-wrap"
        class="hidden md:block absolute right-4 lg:right-12 top-1/2 w-[40vw] max-w-115 z-2 opacity-0 animate-[fadeSlideLeft_1.2s_ease_0.3s_forwards] pointer-events-none"
        style="transform: translateY(-50%)"
      >
        <svg
          viewBox="0 0 480 520"
          fill="none"
          xmlns="http://www.w3.org/2000/svg"
          class="w-full h-auto drop-shadow-[0_20px_50px_rgba(44,30,22,0.15)]"
        >
          <g transform="translate(170, 80)">
            <path
              class="steam-float opacity-0 animate-[steamFloat_3s_ease-in-out_infinite_2s]"
              d="M20 60 Q30 40 20 20 Q10 0 20 -20"
              stroke="var(--clr-accent)"
              stroke-width="2.5"
              stroke-linecap="round"
              fill="none"
            />
            <path
              class="steam-float opacity-0 animate-[steamFloat_3.5s_ease-in-out_infinite_2.4s]"
              d="M50 60 Q60 35 50 15 Q40 -5 50 -25"
              stroke="var(--clr-accent)"
              stroke-width="2"
              stroke-linecap="round"
              fill="none"
            />
            <path
              class="steam-float opacity-0 animate-[steamFloat_2.8s_ease-in-out_infinite_2.8s]"
              d="M80 60 Q90 42 80 22 Q70 2 80 -18"
              stroke="var(--clr-accent)"
              stroke-width="2.5"
              stroke-linecap="round"
              fill="none"
            />
          </g>
          <ellipse cx="240" cy="440" rx="165" ry="22" fill="#D4B896" opacity="0.6" />
          <ellipse cx="240" cy="436" rx="155" ry="16" fill="#C8A882" />
          <ellipse cx="240" cy="432" rx="145" ry="10" fill="#B89060" />
          <path
            d="M100 180 Q95 360 120 420 Q160 445 240 445 Q320 445 360 420 Q385 360 380 180 Z"
            fill="#F5ECD7"
            stroke="#C8A882"
            stroke-width="2"
          />
          <ellipse cx="240" cy="182" rx="137" ry="28" fill="#3D2010" />
          <ellipse cx="240" cy="182" rx="100" ry="20" fill="#D4A574" opacity="0.85" />
          <path
            d="M380 220 Q440 220 445 280 Q450 340 385 355"
            fill="none"
            stroke="#C8A882"
            stroke-width="14"
            stroke-linecap="round"
          />
          <path
            d="M380 220 Q430 222 436 280 Q441 336 385 350"
            fill="none"
            stroke="#F5ECD7"
            stroke-width="7"
            stroke-linecap="round"
          />
        </svg>
      </div>
    )
  }

  {
    isMin && (
      <div class="min-hero absolute inset-0 pointer-events-none overflow-hidden" aria-hidden="true">
        <span class="absolute right-0 bottom-0 text-[clamp(220px,40vw,520px)] font-bold leading-none text-black/3 select-none tracking-[-0.05em] translate-y-[10%] translate-x-[5%]">
          01
        </span>
        <div class="hidden lg:block absolute left-[50%] top-0 bottom-0 w-px bg-black/6" />
      </div>
    )
  }

  <div
    class:list={[
      'relative z-10 w-full mx-auto',
      isMin
        ? 'max-w-7xl px-6 md:px-12 pt-40 pb-32 grid grid-cols-1 lg:grid-cols-2 gap-16 lg:gap-24 items-center'
        : 'max-w-350 px-6 md:px-12 pt-32 pb-24',
    ]}
  >
    <div
      class:list={[
        isMin ? 'min-hero-text' : 'max-w-140 opacity-0 animate-[fadeUp_0.9s_ease_0.1s_forwards]',
      ]}
    >
      {
        isMin ? (
          <div class="flex items-center gap-4 mb-10">
            <span class="w-8 h-px bg-(--clr-accent)" />
            <span class="text-[10px] font-bold tracking-[0.35em] uppercase text-black/40">
              Especialidad · Buenos Aires · Est. 2024
            </span>
          </div>
        ) : (
          <span class="inline-flex items-center gap-2 text-[11px] tracking-[0.18em] uppercase text-(--clr-green) mb-6 before:content-[''] before:w-6 before:h-px before:bg-(--clr-green)">
            Experiencia de Autor
          </span>
        )
      }

      <h1
        class:list={[
          'font-(--font-display) leading-none text-(--clr-ink) mb-8',
          isMin
            ? 'text-[clamp(3rem,8vw,6rem)] font-bold tracking-[-0.04em]'
            : 'text-5xl md:text-6xl lg:text-8xl font-bold tracking-tight font-serif',
        ]}
      >
        {
          isMin ? (
            <>
              El café,
              <br />
              <em class="not-italic text-(--clr-accent)">sin rodeos.</em>
            </>
          ) : (
            <>
              El arte del café,
              <em class="block italic text-(--clr-accent)">perfeccionado.</em>
            </>
          )
        }
      </h1>

      <p
        class:list={[
          'leading-relaxed text-(--clr-ink)/60 mb-10',
          isMin ? 'text-lg max-w-sm font-light' : 'text-base md:text-lg max-w-110 font-light',
        ]}
      >
        {
          isMin
            ? 'Granos de especialidad. Preparación precisa. Sin adornos innecesarios. Solo buen café.'
            : 'Descubre nuestra selección de granos de especialidad. Tostados con precisión, preparados con pasión. Un viaje sensorial en cada taza.'
        }
      </p>

      <div
        class:list={[
          'flex flex-wrap gap-3',
          !isMin && 'opacity-0 animate-[fadeUp_0.9s_ease_0.4s_both]',
        ]}
      >
        {
          isMin ? (
            <>
              <a
                href={menuUrl}
                class="min-cta-primary group inline-flex items-center gap-3 px-8 py-4 bg-black text-white text-[12px] tracking-[0.2em] uppercase font-bold no-underline hover:bg-(--clr-accent) transition-colors duration-200"
              >
                Explorar Catálogo
                <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
                  <path
                    d="M2 7H12M8 3L12 7L8 11"
                    stroke="currentColor"
                    stroke-width="1.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  />
                </svg>
              </a>
              <a
                href="#contact"
                class="inline-flex items-center px-8 py-4 border border-black/30 text-black text-[12px] tracking-[0.2em] uppercase font-bold no-underline hover:border-black transition-colors duration-200"
              >
                Visítanos
              </a>
            </>
          ) : (
            <>
              <a
                href={menuUrl}
                class="px-8 py-3.5 bg-(--clr-ink) text-(--clr-white) text-[13px] tracking-wider uppercase transition-all hover:bg-(--clr-darker) hover:-translate-y-0.5"
              >
                Explorar Catálogo
              </a>
              <a
                href="#contact"
                class="px-8 py-3.5 border border-(--clr-ink) text-(--clr-ink) text-[13px] tracking-wider uppercase transition-all hover:bg-(--clr-ink) hover:text-(--clr-white) hover:-translate-y-0.5"
              >
                Visítanos
              </a>
            </>
          )
        }
      </div>
    </div>

    {
      isMin && (
        <div class="min-stats grid grid-cols-1 gap-0 border-l border-black/10 pl-10 lg:pl-16">
          {[
            { n: '12+', label: 'Orígenes de especialidad', sub: 'África · Asia · América' },
            { n: '6', label: 'Métodos de preparación', sub: 'Espresso, V60, Chemex…' },
            { n: '100%', label: 'Tueste propio, semanal', sub: 'Sin intermediarios' },
          ].map(({ n, label, sub }, i) => (
            <div
              class:list={['py-8 border-b border-black/8 last:border-b-0', 'group']}
              style={`animation-delay: ${i * 120}ms`}
            >
              <span class="block text-[clamp(2.5rem,5vw,4rem)] font-bold text-black tracking-[-0.05em] leading-none mb-1 group-hover:text-(--clr-accent) transition-colors duration-200">
                {n}
              </span>
              <span class="block text-sm font-bold text-black/70 mb-0.5">{label}</span>
              <span class="block text-xs text-black/35 tracking-wide">{sub}</span>
            </div>
          ))}
        </div>
      )
    }
  </div>

  {
    !isMin && (
      <div class="absolute bottom-8 left-1/2 -translate-x-1/2 z-10 flex flex-col items-center gap-1.5 opacity-0 animate-[fadeUp_0.9s_ease_1.5s_forwards]">
        <span class="text-[10px] tracking-[0.15em] uppercase text-(--clr-accent)">Scroll</span>
        <div class="w-px h-10 bg-linear-to-b from-(--clr-accent) to-transparent animate-[scrollPulse_2s_ease-in-out_infinite]" />
      </div>
    )
  }

  {
    isMin && (
      <div class="absolute bottom-8 right-8 md:right-12 z-10 flex flex-col items-end gap-2">
        <span class="text-[10px] tracking-[0.3em] uppercase text-black/25 font-bold">Scroll</span>
        <div class="min-scroll-line w-px h-12 bg-black/15 origin-top" />
      </div>
    )
  }
</section>

<style>
  @keyframes fadeSlideLeft {
    from {
      opacity: 0;
      transform: translateY(-50%) translateX(40px);
    }
    to {
      opacity: 1;
      transform: translateY(-50%) translateX(0);
    }
  }
  @keyframes fadeUp {
    from {
      opacity: 0;
      transform: translateY(24px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
  @keyframes steamFloat {
    0% {
      opacity: 0;
      transform: translateY(0) scaleX(1);
    }
    20% {
      opacity: 0.7;
    }
    80% {
      opacity: 0.3;
    }
    100% {
      opacity: 0;
      transform: translateY(-60px) scaleX(1.4);
    }
  }
  @keyframes scrollPulse {
    0%,
    100% {
      opacity: 0.4;
      transform: scaleY(1);
    }
    50% {
      opacity: 1;
      transform: scaleY(1.1);
    }
  }

  .min-hero-text {
    animation: minFadeUp 0.8s cubic-bezier(0.22, 1, 0.36, 1) 0.1s both;
  }
  .min-stats {
    animation: minFadeUp 0.8s cubic-bezier(0.22, 1, 0.36, 1) 0.3s both;
  }
  @keyframes minFadeUp {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .min-scroll-line {
    animation: scrollGrow 2.4s ease-in-out infinite;
    transform-origin: top;
  }
  @keyframes scrollGrow {
    0%,
    100% {
      transform: scaleY(0.4);
      opacity: 0.3;
    }
    50% {
      transform: scaleY(1);
      opacity: 1;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .min-hero-text,
    .min-stats {
      animation: none;
      opacity: 1;
      transform: none;
    }
    .min-scroll-line {
      animation: none;
    }
  }
</style>

<script>
  ;(function () {
    const canvas = document.getElementById('hero-canvas') as HTMLCanvasElement | null
    if (!canvas) return
    const ctx = canvas.getContext('2d')
    if (!ctx) return

    interface Particle {
      x: number
      y: number
      vx: number
      vy: number
      radius: number
      opacity: number
      color: string
      wobble: number
      wobbleSpeed: number
    }

    const style = getComputedStyle(document.documentElement)
    const accent = style.getPropertyValue('--clr-accent').trim()
    const green = style.getPropertyValue('--clr-green').trim()
    const ink = style.getPropertyValue('--clr-ink').trim()

    let width: number, height: number
    let particles: Particle[] = []
    const mouse = { x: -999, y: -999 }

    function hexToRgba(hex: string, a: number) {
      const h = hex.replace('#', '')
      const r = parseInt(h.slice(0, 2), 16)
      const g = parseInt(h.slice(2, 4), 16)
      const b = parseInt(h.slice(4, 6), 16)
      return `rgba(${r},${g},${b},${a})`
    }

    const COLORS = [accent, green, ink]
    const resize = () => {
      width = canvas.width = canvas.offsetWidth
      height = canvas.height = canvas.offsetHeight
    }
    const createParticle = (): Particle => ({
      x: Math.random() * width,
      y: Math.random() * height,
      vx: (Math.random() - 0.5) * 0.8,
      vy: Math.random() * -0.4 - 0.1,
      radius: Math.random() * 2.6 + 1.2,
      opacity: Math.random() * 0.37 + 0.08,
      color: COLORS[Math.floor(Math.random() * COLORS.length)],
      wobble: Math.random() * Math.PI * 2,
      wobbleSpeed: Math.random() * 0.015 + 0.005,
    })

    const loop = () => {
      ctx.clearRect(0, 0, width, height)
      for (let i = 0; i < particles.length; i++) {
        for (let j = i + 1; j < particles.length; j++) {
          const a = particles[i],
            b = particles[j]
          const dx = a.x - b.x,
            dy = a.y - b.y
          const dist = Math.sqrt(dx * dx + dy * dy)
          if (dist < 80) {
            ctx.beginPath()
            ctx.moveTo(a.x, a.y)
            ctx.lineTo(b.x, b.y)
            ctx.strokeStyle = hexToRgba(accent, (1 - dist / 80) * 0.12)
            ctx.lineWidth = 0.6
            ctx.stroke()
          }
        }
      }
      particles.forEach((p) => {
        p.wobble += p.wobbleSpeed
        p.vx += Math.sin(p.wobble) * 0.008
        const dx = p.x - mouse.x,
          dy = p.y - mouse.y
        const dist = Math.sqrt(dx * dx + dy * dy)
        if (dist < 120) {
          const force = (120 - dist) / 120
          p.vx += (dx / dist) * force * 0.06
          p.vy += (dy / dist) * force * 0.06
        }
        p.x += p.vx *= 0.99
        p.y += p.vy *= 0.99
        if (p.x < -10) p.x = width + 10
        if (p.x > width + 10) p.x = -10
        if (p.y < -10) p.y = height + 10
        ctx.beginPath()
        ctx.arc(p.x, p.y, p.radius, 0, Math.PI * 2)
        ctx.fillStyle = hexToRgba(p.color, p.opacity)
        ctx.fill()
      })
      requestAnimationFrame(loop)
    }

    window.addEventListener('resize', () => {
      resize()
      particles = Array.from({ length: 80 }, createParticle)
    })
    canvas.addEventListener('mousemove', (e) => {
      const r = canvas.getBoundingClientRect()
      mouse.x = e.clientX - r.left
      mouse.y = e.clientY - r.top
    })
    resize()
    particles = Array.from({ length: 80 }, createParticle)
    loop()
  })()
</script>
