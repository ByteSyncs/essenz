---
interface Props {
  theme?: 'modern' | 'minimalist'
  name: string
  tagline?: string | null
}

const { theme = 'modern', name, tagline } = Astro.props
const isMin = theme === 'minimalist'
const menuUrl = `${Astro.url.pathname}/menu`
---

<section
  id="home"
  class:list={[
    'relative flex min-h-[88dvh] items-center overflow-hidden bg-(--clr-bg)',
    isMin ? 'pt-32 pb-16' : 'pt-36 pb-20',
  ]}
>
  {
    isMin ? (
      <div class="mx-auto grid w-full max-w-7xl gap-14 px-6 md:px-12 lg:grid-cols-[1.2fr_0.8fr] lg:items-end">
        <div>
          <span class="mb-7 flex items-center gap-4 text-[10px] font-bold uppercase tracking-[0.28em] text-(--clr-ink)/45">
            <span class="h-px w-8 bg-(--clr-accent)" />
            Sitio oficial · Carta digital
          </span>
          <h1 class="max-w-4xl text-[clamp(3.5rem,10vw,8rem)] leading-[0.84] font-bold tracking-[-0.07em] text-(--clr-ink)">
            {name}
            <span class="text-(--clr-accent)">.</span>
          </h1>
          <p class="mt-7 max-w-xl text-lg leading-relaxed text-(--clr-ink)/60 sm:text-xl">
            {tagline || 'Un lugar para disfrutar buena comida y compartir.'}
          </p>
          <div class="mt-9 flex flex-wrap gap-3">
            <a
              href={menuUrl}
              class="inline-flex min-h-12 items-center gap-4 bg-(--clr-ink) px-6 text-xs font-bold uppercase tracking-[0.15em] text-(--clr-bg) transition-colors hover:bg-(--clr-accent) hover:text-white"
            >
              Ver la carta <span aria-hidden="true">↗</span>
            </a>
            <a
              href="#contact"
              class="inline-flex min-h-12 items-center border border-(--clr-ink)/20 px-6 text-xs font-bold uppercase tracking-[0.15em] text-(--clr-ink) transition-colors hover:border-(--clr-ink)"
            >
              Información del local
            </a>
          </div>
        </div>
        <div class="border-l border-(--clr-ink)/15 pl-6 sm:pl-9">
          <p class="text-[10px] font-bold uppercase tracking-[0.2em] text-(--clr-ink)/40">
            Para tus clientes
          </p>
          <ul class="mt-5 divide-y divide-(--clr-ink)/10 border-y border-(--clr-ink)/10">
            {[
              ['01', 'Información y contacto del negocio'],
              ['02', 'Carta con precios actualizados'],
              ['03', 'Productos y ofertas vigentes'],
            ].map(([number, label]) => (
              <li class="flex items-center gap-5 py-4">
                <span class="text-[10px] font-bold tracking-widest text-(--clr-ink)/35">
                  {number}
                </span>
                <span class="text-sm font-semibold text-(--clr-ink)/80">{label}</span>
              </li>
            ))}
          </ul>
        </div>
      </div>
    ) : (
      <div class="mx-auto grid w-full max-w-7xl items-center gap-12 px-5 sm:px-8 lg:grid-cols-[1fr_0.85fr] lg:gap-20">
        <div class="relative z-10">
          <span class="mb-6 inline-flex items-center gap-3 text-[10px] font-bold uppercase tracking-[0.2em] text-(--clr-green)">
            <span class="h-px w-8 bg-(--clr-green)" />
            El sitio de {name}
          </span>
          <h1 class="max-w-4xl text-5xl leading-[0.96] font-bold tracking-[-0.05em] text-(--clr-ink) sm:text-6xl lg:text-7xl">
            {name}
            <span class="mt-3 block font-(--font-display) italic text-(--clr-accent)">
              {tagline || 'Un buen lugar para encontrarse.'}
            </span>
          </h1>
          <p class="mt-7 max-w-xl text-base leading-relaxed text-(--clr-ink)/65 sm:text-lg">
            Conocé el local, encontrá cómo llegar y consultá su carta digital con productos, precios
            y ofertas al día.
          </p>
          <div class="mt-9 flex flex-wrap gap-3">
            <a
              href={menuUrl}
              class="inline-flex min-h-12 items-center gap-3 rounded-full bg-(--clr-ink) px-7 text-sm font-bold text-(--clr-white) transition hover:bg-(--clr-darker)"
            >
              Explorar la carta <span aria-hidden="true">→</span>
            </a>
            <a
              href="#contact"
              class="inline-flex min-h-12 items-center rounded-full border border-(--clr-ink)/20 px-7 text-sm font-semibold text-(--clr-ink) transition hover:bg-(--clr-white)"
            >
              Contacto y ubicación
            </a>
          </div>
        </div>
        <div class="relative overflow-hidden rounded-4xl bg-(--clr-dark) p-7 text-white sm:p-10">
          <div class="absolute -right-14 -top-16 size-56 rounded-full border border-white/10 sm:size-72" />
          <div class="absolute -right-5 -top-7 size-40 rounded-full border border-white/10 sm:size-52" />
          <div class="relative">
            <span class="text-[10px] font-bold uppercase tracking-[0.22em] text-white/45">
              Una experiencia propia
            </span>
            <h2 class="mt-12 max-w-sm text-3xl leading-tight font-semibold tracking-tight sm:text-4xl">
              Todo lo que el cliente necesita, en un solo lugar.
            </h2>
            <div class="mt-10 grid grid-cols-2 gap-3">
              <div class="rounded-xl bg-white/8 p-4">
                <span class="block text-2xl" aria-hidden="true">
                  ⌂
                </span>
                <span class="mt-3 block text-xs font-semibold text-white/75">
                  Tu espacio online
                </span>
              </div>
              <div class="rounded-xl bg-white/8 p-4">
                <span class="block text-2xl" aria-hidden="true">
                  ≡
                </span>
                <span class="mt-3 block text-xs font-semibold text-white/75">
                  Carta siempre al día
                </span>
              </div>
            </div>
          </div>
        </div>
      </div>
    )
  }
</section>
