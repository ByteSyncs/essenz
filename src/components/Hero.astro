<section
  id="inicio"
  class="relative min-h-dvh w-full flex items-center overflow-hidden bg-[#faf6ef]"
>
  <canvas id="hero-canvas" class="absolute inset-0 w-full h-full z-0"></canvas>

  <div
    class="absolute inset-0 z-1 pointer-events-none bg-[radial-gradient(ellipse_70%_80%_at_60%_50%,transparent_30%,rgba(250,246,239,0.6)_100%)]"
  >
  </div>

  <div
    id="cup-wrap"
    class="hidden md:block absolute right-4 lg:right-12 top-1/2 w-[40vw] max-w-115 z-2 opacity-0 animate-[fadeSlideLeft_1.2s_ease_0.3s_forwards] pointer-events-none"
  >
    <svg
      viewBox="0 0 480 520"
      fill="none"
      xmlns="http://www.w3.org/2000/svg"
      class="w-full h-auto drop-shadow-[0_20px_50px_rgba(44,30,22,0.15)]"
    >
      <g transform="translate(170, 80)">
        <path
          class="steam-float opacity-0 animate-[steamFloat_3s_ease-in-out_infinite_2s]"
          d="M20 60 Q30 40 20 20 Q10 0 20 -20"
          stroke="#8B5A2B"
          stroke-width="2.5"
          stroke-linecap="round"
          fill="none"></path>
        <path
          class="steam-float opacity-0 animate-[steamFloat_3.5s_ease-in-out_infinite_2.4s]"
          d="M50 60 Q60 35 50 15 Q40 -5 50 -25"
          stroke="#8B5A2B"
          stroke-width="2"
          stroke-linecap="round"
          fill="none"></path>
        <path
          class="steam-float opacity-0 animate-[steamFloat_2.8s_ease-in-out_infinite_2.8s]"
          d="M80 60 Q90 42 80 22 Q70 2 80 -18"
          stroke="#8B5A2B"
          stroke-width="2.5"
          stroke-linecap="round"
          fill="none"></path>
      </g>
      <ellipse cx="240" cy="440" rx="165" ry="22" fill="#D4B896" opacity="0.6"></ellipse>
      <ellipse cx="240" cy="436" rx="155" ry="16" fill="#C8A882"></ellipse>
      <ellipse cx="240" cy="432" rx="145" ry="10" fill="#B89060"></ellipse>
      <path
        d="M100 180 Q95 360 120 420 Q160 445 240 445 Q320 445 360 420 Q385 360 380 180 Z"
        fill="#F5ECD7"
        stroke="#C8A882"
        stroke-width="2"></path>
      <ellipse cx="240" cy="182" rx="137" ry="28" fill="#3D2010"></ellipse>
      <ellipse cx="240" cy="182" rx="100" ry="20" fill="#D4A574" opacity="0.85"></ellipse>
      <path
        d="M380 220 Q440 220 445 280 Q450 340 385 355"
        fill="none"
        stroke="#C8A882"
        stroke-width="14"
        stroke-linecap="round"></path>
      <path
        d="M380 220 Q430 222 436 280 Q441 336 385 350"
        fill="none"
        stroke="#F5ECD7"
        stroke-width="7"
        stroke-linecap="round"></path>
    </svg>
  </div>

  <div class="relative z-10 w-full max-w-350 mx-auto px-6 md:px-12 pt-32 pb-24">
    <div class="max-w-140 opacity-0 animate-[fadeUp_0.9s_ease_0.1s_forwards]">
      <span
        class="inline-flex items-center gap-2 text-[11px] font-medium tracking-[0.18em] uppercase text-[#2e4f3f] mb-6 before:content-[''] before:w-6 before:h-px before:bg-[#2e4f3f]"
      >
        Experiencia de Autor
      </span>

      <h1
        class="font-serif text-5xl md:text-6xl lg:text-8xl font-bold leading-[1.05] text-[#2c1e16] mb-6 tracking-tight"
      >
        El arte del café,
        <em class="block italic text-[#8b5a2b]">perfeccionado.</em>
      </h1>

      <p class="text-base md:text-lg leading-relaxed text-[#6b5e4e] mb-10 max-w-110 font-light">
        Descubre nuestra selección de granos de especialidad. Tostados con precisión, preparados con
        pasión. Un viaje sensorial en cada taza.
      </p>

      <div class="flex flex-wrap gap-3 opacity-0 animate-[fadeUp_0.9s_ease_0.4s_both]">
        <a
          href="/carta"
          class="px-8 py-3.5 bg-[#2c1e16] text-white text-[13px] font-medium tracking-wider uppercase transition-all hover:bg-black hover:-translate-y-0.5"
        >
          Explorar Catálogo
        </a>
        <a
          href="#contacto"
          class="px-8 py-3.5 border border-[#2c1e16] text-[#2c1e16] text-[13px] font-medium tracking-wider uppercase transition-all hover:bg-[#2c1e16] hover:text-white hover:-translate-y-0.5"
        >
          Visítanos
        </a>
      </div>
    </div>
